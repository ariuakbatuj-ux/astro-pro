---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Test Wishlist API" description="Testing wishlist functionality">
  <div class="min-h-screen bg-gray-50 py-12">
    <div class="max-w-4xl mx-auto px-4">
      <h1 class="text-3xl font-bold mb-8">Wishlist API Test</h1>
      
      <div class="space-y-6">
        <!-- Test GET -->
        <div class="bg-white rounded-lg shadow p-6">
          <h2 class="text-xl font-bold mb-4">1. GET Wishlist</h2>
          <button onclick="testGet()" class="bg-blue-500 text-white px-6 py-2 rounded hover:bg-blue-600">
            Test GET /api/wishlist?userId=1
          </button>
          <pre id="getResult" class="mt-4 p-4 bg-gray-100 rounded text-sm overflow-auto"></pre>
        </div>

        <!-- Test POST -->
        <div class="bg-white rounded-lg shadow p-6">
          <h2 class="text-xl font-bold mb-4">2. POST Add to Wishlist</h2>
          <div class="flex gap-4 mb-4">
            <input type="number" id="addProductId" placeholder="Product ID" class="border px-4 py-2 rounded" value="1">
            <button onclick="testPost()" class="bg-green-500 text-white px-6 py-2 rounded hover:bg-green-600">
              Test POST /api/wishlist
            </button>
          </div>
          <pre id="postResult" class="mt-4 p-4 bg-gray-100 rounded text-sm overflow-auto"></pre>
        </div>

        <!-- Test DELETE -->
        <div class="bg-white rounded-lg shadow p-6">
          <h2 class="text-xl font-bold mb-4">3. DELETE from Wishlist</h2>
          <div class="flex gap-4 mb-4">
            <input type="number" id="deleteProductId" placeholder="Product ID" class="border px-4 py-2 rounded" value="1">
            <button onclick="testDelete()" class="bg-red-500 text-white px-6 py-2 rounded hover:bg-red-600">
              Test DELETE /api/wishlist
            </button>
          </div>
          <pre id="deleteResult" class="mt-4 p-4 bg-gray-100 rounded text-sm overflow-auto"></pre>
        </div>

        <!-- Database Check -->
        <div class="bg-white rounded-lg shadow p-6">
          <h2 class="text-xl font-bold mb-4">4. Check Database</h2>
          <button onclick="checkDatabase()" class="bg-purple-500 text-white px-6 py-2 rounded hover:bg-purple-600">
            Check Database Connection
          </button>
          <pre id="dbResult" class="mt-4 p-4 bg-gray-100 rounded text-sm overflow-auto"></pre>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    async function testGet() {
      const result = document.getElementById('getResult');
      result.textContent = 'Loading...';
      
      try {
        const response = await fetch('/api/wishlist?userId=1');
        const data = await response.json();
        result.textContent = JSON.stringify(data, null, 2);
      } catch (error) {
        result.textContent = 'Error: ' + error.message;
      }
    }

    async function testPost() {
      const result = document.getElementById('postResult');
      const productId = document.getElementById('addProductId').value;
      result.textContent = 'Loading...';
      
      try {
        const response = await fetch('/api/wishlist', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userId: 1, productId: parseInt(productId) })
        });
        const data = await response.json();
        result.textContent = JSON.stringify(data, null, 2);
      } catch (error) {
        result.textContent = 'Error: ' + error.message;
      }
    }

    async function testDelete() {
      const result = document.getElementById('deleteResult');
      const productId = document.getElementById('deleteProductId').value;
      result.textContent = 'Loading...';
      
      try {
        const response = await fetch(`/api/wishlist?userId=1&productId=${productId}`, {
          method: 'DELETE'
        });
        const data = await response.json();
        result.textContent = JSON.stringify(data, null, 2);
      } catch (error) {
        result.textContent = 'Error: ' + error.message;
      }
    }

    async function checkDatabase() {
      const result = document.getElementById('dbResult');
      result.textContent = 'Checking...';
      
      try {
        const response = await fetch('/api/test/db-connection');
        const data = await response.json();
        result.textContent = JSON.stringify(data, null, 2);
      } catch (error) {
        result.textContent = 'Error: ' + error.message;
      }
    }

    // Auto-run GET on page load
    window.addEventListener('DOMContentLoaded', () => {
      testGet();
    });
  </script>
</Layout>
