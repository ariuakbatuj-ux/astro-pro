---
import Layout from '../layouts/Layout.astro';
import { featuredProducts, categories } from '../data/products';

const productsWithCategories = featuredProducts.map(product => ({
  ...product,
  category: categories.find(c => c._id === product.category_id)
}));
---

<Layout title="Featured Products - Test Page" description="Testing featured products display">
  <div class="container mx-auto px-4 py-8">
    <h1 class="text-4xl font-bold mb-8 text-center">Featured Products</h1>
    
    <div class="mb-8 p-4 bg-blue-50 border border-blue-200 rounded-lg">
      <p class="text-sm text-blue-800">
        <strong>✅ Products loaded from:</strong> Temporary data file (src/data/products.ts)
      </p>
      <p class="text-sm text-blue-800 mt-2">
        <strong>📊 Total products:</strong> {productsWithCategories.length}
      </p>
      <p class="text-sm text-blue-800 mt-2">
        <strong>🔗 API Endpoint:</strong> <code class="bg-white px-2 py-1 rounded">/api/products?featured=true</code>
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {productsWithCategories.map((product) => (
        <div class="bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
          <div class="relative h-64 bg-gray-200">
            {product.images && product.images.length > 0 ? (
              <img 
                src={product.images[0]} 
                alt={product.name}
                class="w-full h-full object-cover"
              />
            ) : (
              <div class="flex items-center justify-center h-full text-gray-400">
                <span>No Image</span>
              </div>
            )}
            {product.featured && (
              <span class="absolute top-2 right-2 bg-yellow-400 text-yellow-900 text-xs font-bold px-2 py-1 rounded">
                Featured
              </span>
            )}
          </div>
          
          <div class="p-4">
            <div class="text-sm text-gray-500 mb-1">
              {product.category?.name || 'Unknown Category'}
            </div>
            <h3 class="text-xl font-semibold mb-2 text-gray-800">
              {product.name}
            </h3>
            <p class="text-gray-600 text-sm mb-4 line-clamp-2">
              {product.description}
            </p>
            
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center text-yellow-500">
                <span class="mr-1">★</span>
                <span class="text-gray-700 font-semibold">{product.rating}</span>
                <span class="text-gray-500 text-sm ml-1">({product.reviews_count})</span>
              </div>
              <div class="text-2xl font-bold text-green-600">
                ${product.price}
              </div>
            </div>
            
            <div class="mb-4">
              <div class="text-sm text-gray-600 mb-2">
                <strong>SKU:</strong> {product.sku}
              </div>
              <div class="text-sm text-gray-600 mb-2">
                <strong>Stock:</strong> {product.stock_quantity} units
              </div>
              {product.variants.colors && (
                <div class="text-sm text-gray-600">
                  <strong>Colors:</strong> {product.variants.colors.join(', ')}
                </div>
              )}
            </div>
            
            <button class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded transition-colors">
              Add to Cart
            </button>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-12 p-6 bg-gray-50 rounded-lg">
      <h2 class="text-2xl font-bold mb-4">🚀 Next Steps</h2>
      <div class="space-y-3 text-gray-700">
        <div class="flex items-start">
          <span class="mr-2">✅</span>
          <div>
            <strong>Products Data Created:</strong> All 6 featured products are loaded from <code class="bg-white px-2 py-1 rounded text-sm">src/data/products.ts</code>
          </div>
        </div>
        <div class="flex items-start">
          <span class="mr-2">✅</span>
          <div>
            <strong>API Endpoint Ready:</strong> Test at <code class="bg-white px-2 py-1 rounded text-sm">/api/products</code>
          </div>
        </div>
        <div class="flex items-start">
          <span class="mr-2">⏳</span>
          <div>
            <strong>Database Integration:</strong> Configure Supabase and run <code class="bg-white px-2 py-1 rounded text-sm">INSERT_FEATURED_PRODUCTS.sql</code>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
