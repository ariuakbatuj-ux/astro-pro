---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';
import bcrypt from 'bcryptjs';

// Fetch all users
const { data: users, error: usersError } = await supabase
  .from('users')
  .select('_id, username, email, password, role, account_status')
  .limit(10);
---

<Layout title="Test Authentication" description="Debug authentication">
  <div class="min-h-screen bg-gray-50 py-12">
    <div class="max-w-4xl mx-auto px-4">
      <h1 class="text-3xl font-bold mb-8">Authentication Debug</h1>
      
      <div class="bg-white rounded-lg shadow p-6 mb-6">
        <h2 class="text-xl font-bold mb-4">Users in Database</h2>
        {usersError ? (
          <div class="text-red-600">Error: {usersError.message}</div>
        ) : users && users.length > 0 ? (
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">ID</th>
                  <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Username</th>
                  <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Email</th>
                  <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Role</th>
                  <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                  <th class="px-4 py-2 text-left text-xs font-medium text-gray-500 uppercase">Password Hash</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                {users.map((user) => (
                  <tr>
                    <td class="px-4 py-2 text-sm">{user._id}</td>
                    <td class="px-4 py-2 text-sm font-medium">{user.username}</td>
                    <td class="px-4 py-2 text-sm">{user.email}</td>
                    <td class="px-4 py-2 text-sm">{user.role}</td>
                    <td class="px-4 py-2 text-sm">
                      <span class={`px-2 py-1 text-xs rounded ${user.account_status === 'active' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800'}`}>
                        {user.account_status}
                      </span>
                    </td>
                    <td class="px-4 py-2 text-sm font-mono text-xs">{user.password ? user.password.substring(0, 20) + '...' : 'NULL'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <div class="text-gray-600">No users found in database</div>
        )}
      </div>

      <div class="bg-white rounded-lg shadow p-6 mb-6">
        <h2 class="text-xl font-bold mb-4">Test Login</h2>
        <form id="testForm" class="space-y-4">
          <div>
            <label class="block text-sm font-medium mb-2">Username/Email</label>
            <input type="text" id="testUsername" class="w-full border rounded px-3 py-2" placeholder="admin" />
          </div>
          <div>
            <label class="block text-sm font-medium mb-2">Password</label>
            <input type="password" id="testPassword" class="w-full border rounded px-3 py-2" placeholder="admin123" />
          </div>
          <button type="submit" class="bg-blue-500 text-white px-6 py-2 rounded hover:bg-blue-600">
            Test Login
          </button>
        </form>
        <pre id="testResult" class="mt-4 p-4 bg-gray-100 rounded text-sm overflow-auto"></pre>
      </div>

      <div class="bg-white rounded-lg shadow p-6 mb-6">
        <h2 class="text-xl font-bold mb-4">Password Verification Test</h2>
        <form id="passwordTestForm" class="space-y-4">
          <div>
            <label class="block text-sm font-medium mb-2">User ID</label>
            <input type="number" id="userId" class="w-full border rounded px-3 py-2" value="1" />
          </div>
          <div>
            <label class="block text-sm font-medium mb-2">Password to Test</label>
            <input type="text" id="passwordTest" class="w-full border rounded px-3 py-2" placeholder="admin123" />
          </div>
          <button type="submit" class="bg-green-500 text-white px-6 py-2 rounded hover:bg-green-600">
            Verify Password
          </button>
        </form>
        <pre id="passwordResult" class="mt-4 p-4 bg-gray-100 rounded text-sm overflow-auto"></pre>
      </div>

      <div class="bg-white rounded-lg shadow p-6">
        <h2 class="text-xl font-bold mb-4">🔧 Reset User Password</h2>
        <div class="bg-yellow-50 border border-yellow-200 rounded p-4 mb-4">
          <p class="text-sm text-yellow-800">⚠️ This will immediately change the user's password!</p>
        </div>
        <form id="resetPasswordForm" class="space-y-4">
          <div>
            <label class="block text-sm font-medium mb-2">Username</label>
            <input type="text" id="resetUsername" class="w-full border rounded px-3 py-2" placeholder="ariuka" />
          </div>
          <div>
            <label class="block text-sm font-medium mb-2">New Password</label>
            <input type="text" id="resetNewPassword" class="w-full border rounded px-3 py-2" placeholder="admin123" />
          </div>
          <button type="submit" class="bg-red-500 text-white px-6 py-2 rounded hover:bg-red-600">
            Reset Password
          </button>
        </form>
        <pre id="resetResult" class="mt-4 p-4 bg-gray-100 rounded text-sm overflow-auto"></pre>
      </div>
    </div>
  </div>

  <script is:inline>
    document.getElementById('testForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const result = document.getElementById('testResult');
      result.textContent = 'Testing...';
      
      const username = document.getElementById('testUsername').value;
      const password = document.getElementById('testPassword').value;
      
      try {
        const response = await fetch('/api/auth/signin', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ emailOrUsername: username, password })
        });
        
        const data = await response.json();
        result.textContent = JSON.stringify({ status: response.status, data }, null, 2);
      } catch (error) {
        result.textContent = 'Error: ' + error.message;
      }
    });

    document.getElementById('passwordTestForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const result = document.getElementById('passwordResult');
      result.textContent = 'Verifying...';
      
      const userId = document.getElementById('userId').value;
      const password = document.getElementById('passwordTest').value;
      
      try {
        const response = await fetch('/api/test/verify-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userId, password })
        });
        
        const data = await response.json();
        result.textContent = JSON.stringify(data, null, 2);
      } catch (error) {
        result.textContent = 'Error: ' + error.message;
      }
    });

    document.getElementById('resetPasswordForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const result = document.getElementById('resetResult');
      result.textContent = 'Resetting password...';
      
      const username = document.getElementById('resetUsername').value;
      const newPassword = document.getElementById('resetNewPassword').value;
      
      if (!confirm(`Reset password for user "${username}" to "${newPassword}"?`)) {
        result.textContent = 'Cancelled';
        return;
      }
      
      try {
        const response = await fetch('/api/test/reset-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, newPassword })
        });
        
        const data = await response.json();
        result.textContent = JSON.stringify(data, null, 2);
        
        if (data.success) {
          alert('✅ Password reset successfully! You can now login with the new password.');
        }
      } catch (error) {
        result.textContent = 'Error: ' + error.message;
      }
    });
  </script>
</Layout>
