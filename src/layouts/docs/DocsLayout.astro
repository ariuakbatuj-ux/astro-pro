---
export interface Props {
  title: string;
  description?: string;
  currentSection?: string;
}

const { title, description, currentSection } = Astro.props;

const navItems = [
  {
    title: "Getting Started",
    items: [
      { title: "Overview", href: "/docs", icon: "📚" },
      { title: "Quick Start", href: "/docs/quick-start", icon: "⚡" },
    ]
  },
  {
    title: "System Architecture",
    items: [
      { title: "Architecture Overview", href: "/docs/architecture", icon: "🏗️" },
      { title: "Request Flow", href: "/docs/request-flow", icon: "🔄" },
      { title: "Data Pipeline", href: "/docs/data-pipeline", icon: "📊" },
    ]
  },
  {
    title: "Function Reference",
    items: [
      { title: "Complete Function Inventory", href: "/docs/functions", icon: "📋" },
      { title: "Frontend Functions", href: "/docs/frontend-functions", icon: "🌐" },
      { title: "Backend Functions", href: "/docs/backend-functions", icon: "⚙️" },
    ]
  },
  {
    title: "File Structure",
    items: [
      { title: "File Locations Map", href: "/docs/file-locations", icon: "🗺️" },
      { title: "URL Endpoints", href: "/docs/endpoints", icon: "🔗" },
      { title: "Search & Navigation", href: "/docs/search", icon: "🔍" },
    ]
  },
  {
    title: "Implementation Details",
    items: [
      { title: "Image Upload System", href: "/docs/image-upload", icon: "🖼️" },
      { title: "Form Validation", href: "/docs/form-validation", icon: "✅" },
      { title: "Database Schema", href: "/docs/database", icon: "🗄️" },
    ]
  }
];
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description || "Complete technical documentation for the product management system"} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Technical Documentation</title>
    
    <!-- Syntax highlighting -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-core.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/autoloader/prism-autoloader.min.js"></script>
  </head>
  <body class="bg-gray-50 font-sans">
    <div class="min-h-screen flex">
      <!-- Sidebar Navigation -->
      <aside class="w-80 bg-white border-r border-gray-200 overflow-y-auto">
        <div class="p-6">
          <!-- Logo -->
          <div class="flex items-center space-x-3 mb-8">
            <div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-purple-600 rounded-xl flex items-center justify-center">
              <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
              </svg>
            </div>
            <div>
              <h1 class="text-xl font-bold text-gray-800">Tech Docs</h1>
              <p class="text-sm text-gray-500">Complete System Guide</p>
            </div>
          </div>

          <!-- Search Box -->
          <div class="relative mb-6">
            <input 
              type="search" 
              placeholder="Search documentation..."
              class="w-full pl-10 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:bg-white transition-colors"
              id="docSearch"
            />
            <svg class="absolute left-3 top-3.5 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
          </div>

          <!-- Navigation Menu -->
          <nav class="space-y-6">
            {navItems.map((section) => (
              <div>
                <h3 class="text-xs font-semibold text-gray-900 uppercase tracking-wider mb-3">{section.title}</h3>
                <ul class="space-y-1">
                  {section.items.map((item) => (
                    <li>
                      <a 
                        href={item.href}
                        class={`flex items-center space-x-3 px-3 py-2 rounded-lg text-sm transition-colors ${
                          Astro.url.pathname === item.href 
                            ? 'bg-blue-50 text-blue-700 border-r-2 border-blue-500' 
                            : 'text-gray-700 hover:bg-gray-100'
                        }`}
                      >
                        <span class="text-base">{item.icon}</span>
                        <span class="font-medium">{item.title}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </nav>

          <!-- Version Info -->
          <div class="mt-8 pt-6 border-t border-gray-200">
            <div class="bg-gradient-to-r from-blue-50 to-purple-50 rounded-lg p-4">
              <div class="flex items-center space-x-2 mb-2">
                <svg class="w-4 h-4 text-blue-600" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                </svg>
                <span class="text-sm font-medium text-blue-800">System Status</span>
              </div>
              <p class="text-xs text-blue-600">All 25 functions documented</p>
              <p class="text-xs text-blue-600">Complete architecture mapped</p>
            </div>
          </div>
        </div>
      </aside>

      <!-- Main Content Area -->
      <main class="flex-1 overflow-y-auto">
        <!-- Header -->
        <header class="bg-white border-b border-gray-200 px-8 py-6">
          <div class="flex items-center justify-between">
            <div>
              <h1 class="text-3xl font-bold text-gray-900">{title}</h1>
              {description && (
                <p class="text-lg text-gray-600 mt-1">{description}</p>
              )}
            </div>

            <div class="flex items-center space-x-4">
              <!-- Breadcrumb -->
              <nav class="text-sm text-gray-500">
                <span>Documentation</span>
                <span class="mx-2">/</span>
                <span class="text-gray-800 font-medium">{title}</span>
              </nav>

              <!-- Theme Toggle -->
              <button 
                id="themeToggle"
                class="p-2 rounded-lg bg-gray-100 hover:bg-gray-200 transition-colors"
                title="Toggle theme"
              >
                <svg class="w-4 h-4 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
                </svg>
              </button>

              <!-- GitHub Link -->
              <a 
                href="#"
                class="p-2 rounded-lg bg-gray-100 hover:bg-gray-200 transition-colors"
                title="View source"
              >
                <svg class="w-4 h-4 text-gray-600" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
              </a>
            </div>
          </div>
        </header>

        <!-- Page Content -->
        <div class="px-8 py-8">
          <div class="max-w-4xl mx-auto">
            <slot />
          </div>
        </div>

        <!-- Footer -->
        <footer class="bg-white border-t border-gray-200 px-8 py-6 mt-12">
          <div class="max-w-4xl mx-auto">
            <div class="flex items-center justify-between text-sm text-gray-500">
              <p>© 2025 Technical Documentation. All functions documented.</p>
              <div class="flex items-center space-x-4">
                <span>Last updated: October 18, 2025</span>
                <span>•</span>
                <span>25 Functions • 3 Architectures • Complete Coverage</span>
              </div>
            </div>
          </div>
        </footer>
      </main>
    </div>

    <!-- Search functionality -->
    <script>
      // Simple search functionality
      const searchElement = document.getElementById('docSearch');
      if (searchElement) {
        searchElement.addEventListener('input', function(e) {
          const target = e.target as HTMLInputElement;
          if (target) {
            const query = target.value.toLowerCase();
            const navItems = document.querySelectorAll('nav a');
            
            navItems.forEach(item => {
              const text = item.textContent?.toLowerCase() || '';
              const parent = item.closest('li');
              
              if (parent) {
                if (text.includes(query) || query === '') {
                  parent.style.display = 'block';
                } else {
                  parent.style.display = 'none';
                }
              }
            });
          }
        });
      }

      // Theme toggle (placeholder)
      const themeToggle = document.getElementById('themeToggle');
      if (themeToggle) {
        themeToggle.addEventListener('click', function() {
          document.body.classList.toggle('dark');
        });
      }
    </script>

    <style>
      /* Custom scrollbar */
      ::-webkit-scrollbar {
        width: 6px;
      }
      
      ::-webkit-scrollbar-track {
        background: #f1f1f1;
      }
      
      ::-webkit-scrollbar-thumb {
        background: #c1c1c1;
        border-radius: 3px;
      }
      
      ::-webkit-scrollbar-thumb:hover {
        background: #a8a8a8;
      }

      /* Code highlighting improvements */
      pre[class*="language-"] {
        margin: 1.5rem 0;
        border-radius: 0.75rem;
        border: 1px solid #e5e7eb;
      }

      code[class*="language-"] {
        font-size: 0.875rem;
        line-height: 1.5;
      }

      /* Dark mode support */
      body.dark {
        background-color: #111827;
        color: #f9fafb;
      }
    </style>
  </body>
</html>