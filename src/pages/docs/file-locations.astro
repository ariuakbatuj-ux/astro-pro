                <div class="text-xs text-blue-600">getProducts()</div>
              </div>
            </div>

            <div class="bg-purple-50 p-3 rounded-lg border-l-4 border-purple-500">
              <div class="flex justify-between items-start">
                <div>
                  <div class="font-medium text-purple-800">GET /admin/add-product</div>
                  <div class="text-sm text-purple-700">Add product form</div>
                </div>
                <div class="text-xs text-purple-600">getAddProduct()</div>
              </div>
            </div>

            <div class="bg-orange-50 p-3 rounded-lg border-l-4 border-orange-500">
              <div class="flex justify-between items-start">
                <div>
                  <div class="font-medium text-orange-800">POST /admin/add-product</div>
