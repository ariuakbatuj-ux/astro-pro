        <!-- Static & Asset Endpoints -->
        <div>
          <h4 class="font-semibold text-gray-900 mb-4">📁 Static & Asset URLs</h4>
          <div class="space-y-3">
            <div class="bg-gray-50 p-3 rounded-lg">
              <div class="font-medium text-gray-800">/images/*</div>
              <div class="text-sm text-gray-600">Product images directory</div>
