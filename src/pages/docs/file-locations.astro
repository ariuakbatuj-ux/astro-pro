            </div>

            <div class="bg-gray-50 p-3 rounded-lg">
              <div class="font-medium text-gray-800">/css/*</div>
              <div class="text-sm text-gray-600">Stylesheet files</div>
              <div class="text-xs text-gray-500">Bootstrap + custom CSS</div>
            </div>

            <div class="bg-gray-50 p-3 rounded-lg">
              <div class="font-medium text-gray-800">/js/*</div>
              <div class="text-sm text-gray-600">JavaScript files</div>
              <div class="text-xs text-gray-500">jQuery + Bootstrap JS</div>
            </div>

            <div class="bg-yellow-50 p-3 rounded-lg border border-yellow-200">
              <div class="font-medium text-yellow-800">File Upload Endpoint</div>
