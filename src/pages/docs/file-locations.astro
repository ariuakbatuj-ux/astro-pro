              </div>
            </div>

            <div class="bg-indigo-50 p-3 rounded-lg border-l-4 border-indigo-500">
              <div class="flex justify-between items-start">
                <div>
                  <div class="font-medium text-indigo-800">GET /admin/edit/:id</div>
                  <div class="text-sm text-indigo-700">Edit product form</div>
                </div>
                <div class="text-xs text-indigo-600">getEditProduct()</div>
              </div>
            </div>

            <div class="bg-teal-50 p-3 rounded-lg border-l-4 border-teal-500">
              <div class="flex justify-between items-start">
                <div>
                  <div class="font-medium text-teal-800">PUT /admin/update/:id</div>
