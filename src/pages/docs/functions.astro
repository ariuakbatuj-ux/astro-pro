---
import DocsLayout from '../../layouts/docs/DocsLayout.astro';
---

<DocsLayout 
  title="Complete Function Inventory" 
  description="All 25 functions documented with exact line numbers, purposes, and implementation details"
>
  <!-- Overview Section -->
  <div class="bg-blue-50 rounded-xl p-6 mb-8 border border-blue-200">
    <h2 class="text-xl font-bold text-blue-900 mb-3">📋 Function Inventory Overview</h2>
    <p class="text-blue-800 mb-4">
      Complete documentation of all 25 functions in the product management system, organized by location and functionality.
    </p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="bg-white rounded-lg p-4">
        <div class="text-2xl font-bold text-blue-600">14</div>
        <div class="text-sm text-gray-600">Frontend Functions</div>
      </div>
      <div class="bg-white rounded-lg p-4">
        <div class="text-2xl font-bold text-green-600">10</div>
        <div class="text-sm text-gray-600">Backend Functions</div>
      </div>
      <div class="bg-white rounded-lg p-4">
        <div class="text-2xl font-bold text-purple-600">1</div>
        <div class="text-sm text-gray-600">Database Schema</div>
      </div>
    </div>
  </div>

  <!-- Frontend Functions Section -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
      <span class="text-2xl mr-3">🌐</span>
      Frontend Functions (Browser - add-product.ejs)
    </h2>

    <div class="space-y-6">
      <!-- Function 1: DOMContentLoaded -->
      <div class="bg-white rounded-xl p-6 border border-gray-200 shadow-sm">
        <div class="flex items-start justify-between mb-4">
          <div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">1. DOMContentLoaded Event Handler</h3>
            <div class="flex items-center space-x-4 text-sm">
              <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded-md font-mono">Line 420-425</span>
              <span class="bg-green-100 text-green-800 px-2 py-1 rounded-md">Page Initialization</span>
            </div>
          </div>
          <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3"/>
          </svg>
        </div>
        <p class="text-gray-700 mb-4">
          <strong>Purpose:</strong> Initializes the entire page when DOM is fully loaded. Sets up all event listeners and initializes components.
        </p>
        <div class="bg-gray-50 rounded-lg p-4">
          <h4 class="font-medium text-gray-800 mb-2">Code Example:</h4>
          <pre class="language-javascript"><code>document.addEventListener('DOMContentLoaded', function() {
    initImageUpload();
    initSizeColorButtons();
    initFormSubmission();
    console.log('Add Product page initialized');
});</code></pre>
        </div>
        <div class="mt-4">
          <h4 class="font-medium text-gray-800 mb-2">Dependencies:</h4>
          <div class="flex flex-wrap gap-2">
            <span class="bg-gray-100 text-gray-700 px-2 py-1 rounded text-sm">initImageUpload()</span>
            <span class="bg-gray-100 text-gray-700 px-2 py-1 rounded text-sm">initSizeColorButtons()</span>
            <span class="bg-gray-100 text-gray-700 px-2 py-1 rounded text-sm">initFormSubmission()</span>
          </div>
        </div>
      </div>

      <!-- Function 2: initImageUpload -->
      <div class="bg-white rounded-xl p-6 border border-gray-200 shadow-sm">
        <div class="flex items-start justify-between mb-4">
          <div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">2. initImageUpload()</h3>
            <div class="flex items-center space-x-4 text-sm">
              <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded-md font-mono">Line 35-50</span>
              <span class="bg-purple-100 text-purple-800 px-2 py-1 rounded-md">Image System</span>
            </div>
          </div>
          <svg class="w-5 h-5 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
        </div>
        <p class="text-gray-700 mb-4">
          <strong>Purpose:</strong> Sets up the image upload system with drag & drop functionality and file input handlers.
        </p>
        <div class="bg-gray-50 rounded-lg p-4">
          <h4 class="font-medium text-gray-800 mb-2">Code Example:</h4>
          <pre class="language-javascript"><code>function initImageUpload() {
    const dropzone = document.getElementById('image-dropzone');
    const fileInput = document.getElementById('product-images');
    
    // Drag and drop handlers
    dropzone.addEventListener('dragover', handleDragOver);
    dropzone.addEventListener('drop', handleDrop);
    fileInput.addEventListener('change', handleFiles);
}</code></pre>
        </div>
        <div class="mt-4">
          <h4 class="font-medium text-gray-800 mb-2">Event Handlers:</h4>
          <div class="flex flex-wrap gap-2">
            <span class="bg-gray-100 text-gray-700 px-2 py-1 rounded text-sm">dragover</span>
            <span class="bg-gray-100 text-gray-700 px-2 py-1 rounded text-sm">drop</span>
            <span class="bg-gray-100 text-gray-700 px-2 py-1 rounded text-sm">change</span>
          </div>
        </div>
      </div>

      <!-- Function 3: handleFiles -->
      <div class="bg-white rounded-xl p-6 border border-gray-200 shadow-sm">
        <div class="flex items-start justify-between mb-4">
          <div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">3. handleFiles(event)</h3>
            <div class="flex items-center space-x-4 text-sm">
              <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded-md font-mono">Line 75-110</span>
              <span class="bg-orange-100 text-orange-800 px-2 py-1 rounded-md">File Processing</span>
            </div>
          </div>
          <svg class="w-5 h-5 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
          </svg>
        </div>
        <p class="text-gray-700 mb-4">
          <strong>Purpose:</strong> Processes selected files, validates them (type and size), and creates preview thumbnails.
        </p>
        <div class="bg-gray-50 rounded-lg p-4">
          <h4 class="font-medium text-gray-800 mb-2">Code Example:</h4>
          <pre class="language-javascript"><code>function handleFiles(event) {
    const files = event.target.files || event.dataTransfer.files;
    
    for (let file of files) {
        if (validateFile(file)) {
            createPreview(file);
            updateFileInput();
        }
    }
}</code></pre>
        </div>
        <div class="mt-4">
          <h4 class="font-medium text-gray-800 mb-2">Validation Rules:</h4>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
            <div class="bg-green-50 p-3 rounded-lg">
              <div class="font-medium text-green-800">File Types</div>
              <div class="text-green-700">image/jpeg, image/png, image/gif</div>
            </div>
            <div class="bg-blue-50 p-3 rounded-lg">
              <div class="font-medium text-blue-800">Max Size</div>
              <div class="text-blue-700">5MB per file</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Function 4: createPreview -->
      <div class="bg-white rounded-xl p-6 border border-gray-200 shadow-sm">
        <div class="flex items-start justify-between mb-4">
          <div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">4. createPreview(file)</h3>
            <div class="flex items-center space-x-4 text-sm">
              <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded-md font-mono">Line 125-160</span>
              <span class="bg-indigo-100 text-indigo-800 px-2 py-1 rounded-md">UI Generation</span>
            </div>
          </div>
          <svg class="w-5 h-5 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
        </div>
        <p class="text-gray-700 mb-4">
          <strong>Purpose:</strong> Creates image preview thumbnails using FileReader API and adds them to the preview container.
        </p>
        <div class="bg-gray-50 rounded-lg p-4">
          <h4 class="font-medium text-gray-800 mb-2">Code Example:</h4>
          <pre class="language-javascript"><code>function createPreview(file) {
    const reader = new FileReader();
    reader.onload = function(e) {
        const preview = document.createElement('div');
        preview.className = 'image-preview-item';
        preview.innerHTML = `
            &lt;img src="${e.target.result}" alt="Preview"&gt;
            &lt;button onclick="removePreview(this)"&gt;×&lt;/button&gt;
        `;
        document.getElementById('preview-container').appendChild(preview);
    };
    reader.readAsDataURL(file);
}</code></pre>
        </div>
        <div class="mt-4">
          <h4 class="font-medium text-gray-800 mb-2">Technologies Used:</h4>
          <div class="flex flex-wrap gap-2">
            <span class="bg-gray-100 text-gray-700 px-2 py-1 rounded text-sm">FileReader API</span>
            <span class="bg-gray-100 text-gray-700 px-2 py-1 rounded text-sm">createElement()</span>
            <span class="bg-gray-100 text-gray-700 px-2 py-1 rounded text-sm">readAsDataURL()</span>
          </div>
        </div>
      </div>

      <!-- Function 5: removePreview -->
      <div class="bg-white rounded-xl p-6 border border-gray-200 shadow-sm">
        <div class="flex items-start justify-between mb-4">
          <div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">5. removePreview(button)</h3>
            <div class="flex items-center space-x-4 text-sm">
              <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded-md font-mono">Line 175-185</span>
              <span class="bg-red-100 text-red-800 px-2 py-1 rounded-md">Remove Handler</span>
            </div>
          </div>
          <svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
          </svg>
        </div>
        <p class="text-gray-700 mb-4">
          <strong>Purpose:</strong> Removes image preview from UI and updates the underlying file input to maintain synchronization.
        </p>
        <div class="bg-gray-50 rounded-lg p-4">
          <h4 class="font-medium text-gray-800 mb-2">Code Example:</h4>
          <pre class="language-javascript"><code>function removePreview(button) {
    const previewItem = button.closest('.image-preview-item');
    const index = Array.from(previewItem.parentNode.children).indexOf(previewItem);
    
    // Remove from DOM
    previewItem.remove();
    
    // Update file input
    updateFileInput(index);
}</code></pre>
        </div>
        <div class="mt-4">
          <h4 class="font-medium text-gray-800 mb-2">DOM Operations:</h4>
          <div class="flex flex-wrap gap-2">
            <span class="bg-gray-100 text-gray-700 px-2 py-1 rounded text-sm">closest()</span>
            <span class="bg-gray-100 text-gray-700 px-2 py-1 rounded text-sm">indexOf()</span>
            <span class="bg-gray-100 text-gray-700 px-2 py-1 rounded text-sm">remove()</span>
          </div>
        </div>
      </div>

      <!-- Continue with more functions... -->
      <div class="bg-gradient-to-r from-blue-50 to-purple-50 rounded-lg p-6 border border-blue-200">
        <h4 class="font-medium text-blue-900 mb-2">🚀 Additional Frontend Functions</h4>
        <p class="text-blue-800 text-sm mb-3">
          The complete system includes 9 more frontend functions covering size/color management, form validation, and data serialization.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3 text-xs">
          <div class="bg-white p-3 rounded">
            <div class="font-medium">addSize()</div>
            <div class="text-gray-600">Dynamic size forms</div>
          </div>
          <div class="bg-white p-3 rounded">
            <div class="font-medium">updateSizes()</div>
            <div class="text-gray-600">Size data serialization</div>
          </div>
          <div class="bg-white p-3 rounded">
            <div class="font-medium">validateForm()</div>
            <div class="text-gray-600">Client-side validation</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Backend Functions Section -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
      <span class="text-2xl mr-3">⚙️</span>
      Backend Functions (Server - adminController.js)
    </h2>

    <div class="space-y-6">
      <!-- Function 15: getAddProduct -->
      <div class="bg-white rounded-xl p-6 border border-gray-200 shadow-sm">
        <div class="flex items-start justify-between mb-4">
          <div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">15. getAddProduct(req, res)</h3>
            <div class="flex items-center space-x-4 text-sm">
              <span class="bg-green-100 text-green-800 px-2 py-1 rounded-md font-mono">Line 145-155</span>
              <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded-md">Route Controller</span>
            </div>
          </div>
          <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
        </div>
        <p class="text-gray-700 mb-4">
          <strong>Purpose:</strong> Renders the add-product page with necessary data for dropdowns and form initialization.
        </p>
        <div class="bg-gray-50 rounded-lg p-4">
          <h4 class="font-medium text-gray-800 mb-2">Code Example:</h4>
          <pre class="language-javascript"><code>const getAddProduct = async (req, res) => {
    try {
        const categories = await Category.find({}).sort({ name: 1 });
        res.render('admin/add-product', {
            title: 'Add New Product',
            categories,
            user: req.session.user
        });
    } catch (error) {
        res.status(500).render('error', { error });
    }
};</code></pre>
        </div>
        <div class="mt-4">
          <h4 class="font-medium text-gray-800 mb-2">Data Provided:</h4>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
            <div class="bg-blue-50 p-3 rounded-lg">
              <div class="font-medium text-blue-800">Categories List</div>
              <div class="text-blue-700">Sorted category dropdown options</div>
            </div>
            <div class="bg-purple-50 p-3 rounded-lg">
              <div class="font-medium text-purple-800">User Session</div>
              <div class="text-purple-700">Current admin user data</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Function 16: createProduct -->
      <div class="bg-white rounded-xl p-6 border border-gray-200 shadow-sm">
        <div class="flex items-start justify-between mb-4">
          <div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">16. createProduct(req, res)</h3>
            <div class="flex items-center space-x-4 text-sm">
              <span class="bg-green-100 text-green-800 px-2 py-1 rounded-md font-mono">Line 185-250</span>
              <span class="bg-orange-100 text-orange-800 px-2 py-1 rounded-md">Form Processor</span>
            </div>
          </div>
          <svg class="w-5 h-5 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
          </svg>
        </div>
        <p class="text-gray-700 mb-4">
          <strong>Purpose:</strong> Processes form submission, handles file uploads, validates data, and saves new product to database.
        </p>
        <div class="bg-gray-50 rounded-lg p-4">
          <h4 class="font-medium text-gray-800 mb-2">Code Example:</h4>
          <pre class="language-javascript"><code>const createProduct = async (req, res) => {
    try {
        const { name, description, price, category } = req.body;
        const images = req.files.map(file =&gt; file.filename);
        
        const product = new Product({
            name, description, price, category,
            images, sizes: JSON.parse(req.body.sizes),
            colors: JSON.parse(req.body.colors)
        });
        
        await product.save();
        req.flash('success', 'Product added successfully');
        res.redirect('/admin/products');
    } catch (error) {
        req.flash('error', 'Error adding product');
        res.redirect('/admin/add-product');
    }
};</code></pre>
        </div>
        <div class="mt-4">
          <h4 class="font-medium text-gray-800 mb-2">Processing Steps:</h4>
          <div class="space-y-2 text-sm">
            <div class="flex items-center space-x-2">
              <div class="w-6 h-6 bg-blue-100 rounded-full flex items-center justify-center text-blue-600 font-bold text-xs">1</div>
              <span>Extract form data from req.body</span>
            </div>
            <div class="flex items-center space-x-2">
              <div class="w-6 h-6 bg-blue-100 rounded-full flex items-center justify-center text-blue-600 font-bold text-xs">2</div>
              <span>Process uploaded images from req.files</span>
            </div>
            <div class="flex items-center space-x-2">
              <div class="w-6 h-6 bg-blue-100 rounded-full flex items-center justify-center text-blue-600 font-bold text-xs">3</div>
              <span>Parse JSON data for sizes and colors</span>
            </div>
            <div class="flex items-center space-x-2">
              <div class="w-6 h-6 bg-blue-100 rounded-full flex items-center justify-center text-blue-600 font-bold text-xs">4</div>
              <span>Save to MongoDB with Mongoose</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Middleware Function -->
      <div class="bg-white rounded-xl p-6 border border-gray-200 shadow-sm">
        <div class="flex items-start justify-between mb-4">
          <div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">17. uploadProductImages (Multer Middleware)</h3>
            <div class="flex items-center space-x-4 text-sm">
              <span class="bg-green-100 text-green-800 px-2 py-1 rounded-md font-mono">Line 15-35</span>
              <span class="bg-yellow-100 text-yellow-800 px-2 py-1 rounded-md">File Upload</span>
            </div>
          </div>
          <svg class="w-5 h-5 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>
          </svg>
        </div>
        <p class="text-gray-700 mb-4">
          <strong>Purpose:</strong> Multer middleware for handling multipart form data and file uploads with proper storage configuration.
        </p>
        <div class="bg-gray-50 rounded-lg p-4">
          <h4 class="font-medium text-gray-800 mb-2">Code Example:</h4>
          <pre class="language-javascript"><code>const storage = multer.diskStorage({
    destination: function (req, file, cb) {
        cb(null, 'images')
    },
    filename: function (req, file, cb) {
        const timestamp = Date.now();
        const random = Math.round(Math.random() * 1E9);
        cb(null, `product-${timestamp}-${random}.${file.originalname.split('.').pop()}`);
    }
});

const uploadProductImages = multer({
    storage: storage,
    limits: { fileSize: 5 * 1024 * 1024 }, // 5MB limit
    fileFilter: (req, file, cb) => {
        if (file.mimetype.startsWith('image/')) {
            cb(null, true);
        } else {
            cb(new Error('Only image files allowed'), false);
        }
    }
}).array('productImages', 10);</code></pre>
        </div>
        <div class="mt-4">
          <h4 class="font-medium text-gray-800 mb-2">Configuration:</h4>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
            <div class="bg-green-50 p-3 rounded-lg">
              <div class="font-medium text-green-800">Storage</div>
              <div class="text-green-700">images/ directory</div>
            </div>
            <div class="bg-blue-50 p-3 rounded-lg">
              <div class="font-medium text-blue-800">Limit</div>
              <div class="text-blue-700">5MB per file, 10 files max</div>
            </div>
            <div class="bg-purple-50 p-3 rounded-lg">
              <div class="font-medium text-purple-800">Filter</div>
              <div class="text-purple-700">Images only</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Additional Backend Functions Summary -->
      <div class="bg-gradient-to-r from-green-50 to-blue-50 rounded-lg p-6 border border-green-200">
        <h4 class="font-medium text-green-900 mb-2">⚙️ Additional Backend Functions</h4>
        <p class="text-green-800 text-sm mb-3">
          Complete backend system includes 7 more functions for product management, CRUD operations, and admin functionality.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 text-xs">
          <div class="bg-white p-3 rounded">
            <div class="font-medium">getProducts()</div>
            <div class="text-gray-600">List all products</div>
          </div>
          <div class="bg-white p-3 rounded">
            <div class="font-medium">updateProduct()</div>
            <div class="text-gray-600">Edit existing product</div>
          </div>
          <div class="bg-white p-3 rounded">
            <div class="font-medium">deleteProduct()</div>
            <div class="text-gray-600">Remove product</div>
          </div>
          <div class="bg-white p-3 rounded">
            <div class="font-medium">dashboard()</div>
            <div class="text-gray-600">Admin dashboard</div>
          </div>
          <div class="bg-white p-3 rounded">
            <div class="font-medium">storage.destination()</div>
            <div class="text-gray-600">File storage path</div>
          </div>
          <div class="bg-white p-3 rounded">
            <div class="font-medium">storage.filename()</div>
            <div class="text-gray-600">File naming logic</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Database Schema Section -->
  <section class="mb-12">
    <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
      <span class="text-2xl mr-3">🗄️</span>
      Database Schema (Product Model)
    </h2>

    <div class="bg-white rounded-xl p-6 border border-gray-200 shadow-sm">
      <div class="flex items-start justify-between mb-4">
