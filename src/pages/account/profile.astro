    let selectedAimag = '';
    let selectedDistrictSum = '';
    let selectedHoroo = '';

    // Store profile data for pre-population
    const savedAimag = window.__SAVED_ADDRESS__ || {aimag: '', sum: '', horoo: ''};

    function toggleEditAddress() {
      const form = document.getElementById('addressForm');
      const saved = document.getElementById('savedAddress');
      const btn = document.getElementById('editAddressBtn');
      
      if (form.classList.contains('hidden')) {
        form.classList.remove('hidden');
        saved.classList.add('hidden');
        btn.textContent = 'Cancel';
        setupWaterfallLogic();
        loadExistingAddress();
      } else {
        form.classList.add('hidden');
        saved.classList.remove('hidden');
        btn.textContent = 'Edit';
      }
    }

    function loadExistingAddress() {
      if (!savedAimag.aimag) return;

      const aimagSelect = document.getElementById('aimagSelect');
      const districtSumSelect = document.getElementById('districtSumSelect');
      const horooSelect = document.getElementById('horooSelect');
      const districtSumContainer = document.getElementById('districtSumContainer');
      const horooContainer = document.getElementById('horooContainer');
      const districtSumLabel = document.getElementById('districtSumLabel');

      // Set level 1
      aimagSelect.value = savedAimag.aimag;
      selectedAimag = savedAimag.aimag;

      const region = addressData[selectedAimag];
      if (!region) return;

      // Populate level 2
      districtSumSelect.innerHTML = '<option value="">-- Select --</option>';
      
      if (region.type === 'city') {
        districtSumLabel.textContent = 'District';
        Object.keys(region.districts).forEach(district => {
          const option = document.createElement('option');
          option.value = district;
          option.textContent = district;
          if (district === savedAimag.sum) option.selected = true;
          districtSumSelect.appendChild(option);
        });
      } else {
        districtSumLabel.textContent = 'Sum';
        region.sums.forEach(sum => {
          const option = document.createElement('option');
          option.value = sum;
          option.textContent = sum;
          if (sum === savedAimag.sum) option.selected = true;
          districtSumSelect.appendChild(option);
        });
      }

      districtSumContainer.classList.remove('hidden');
      selectedDistrictSum = savedAimag.sum;

      // Populate level 3 if Ulaanbaatar
      if (region.type === 'city' && savedAimag.sum) {
        const district = region.districts[savedAimag.sum];
        if (district) {
          horooSelect.innerHTML = '<option value="">-- Select Horoo --</option>';
          district.horoos.forEach(horoo => {
            const option = document.createElement('option');
            option.value = horoo;
            option.textContent = horoo;
            if (horoo === savedAimag.horoo) option.selected = true;
            horooSelect.appendChild(option);
          });
          horooContainer.classList.remove('hidden');
          selectedHoroo = savedAimag.horoo;
        }
      }

      // Show selected address
      if (selectedAimag && selectedDistrictSum) {
        updateSelectedAddress();
      }
    }

    function cancelEditAddress() {
      document.getElementById('addressForm').classList.add('hidden');
      document.getElementById('savedAddress').classList.remove('hidden');
      document.getElementById('editAddressBtn').textContent = 'Edit';
      resetAddressForm();
    }

    function resetAddressForm() {
      document.getElementById('aimagSelect').value = '';
      document.getElementById('districtSumContainer').classList.add('hidden');
      document.getElementById('horooContainer').classList.add('hidden');
      document.getElementById('selectedAddressDisplay').classList.add('hidden');
      selectedAimag = '';
      selectedDistrictSum = '';
      selectedHoroo = '';
    }

    function setupWaterfallLogic() {
      const aimagSelect = document.getElementById('aimagSelect');
      const districtSumSelect = document.getElementById('districtSumSelect');
      const horooSelect = document.getElementById('horooSelect');
      const districtSumContainer = document.getElementById('districtSumContainer');
      const horooContainer = document.getElementById('horooContainer');
      const districtSumLabel = document.getElementById('districtSumLabel');
      const selectedDisplay = document.getElementById('selectedAddressDisplay');
      const selectedText = document.getElementById('selectedAddressText');

      // Remove old listeners by cloning elements
      const newAimagSelect = aimagSelect.cloneNode(true);
      aimagSelect.parentNode.replaceChild(newAimagSelect, aimagSelect);
      const newDistrictSumSelect = districtSumSelect.cloneNode(true);
      districtSumSelect.parentNode.replaceChild(newDistrictSumSelect, districtSumSelect);
      const newHorooSelect = horooSelect.cloneNode(true);
      horooSelect.parentNode.replaceChild(newHorooSelect, horooSelect);

      // Update references
      const aimagSelectNew = document.getElementById('aimagSelect');
      const districtSumSelectNew = document.getElementById('districtSumSelect');
      const horooSelectNew = document.getElementById('horooSelect');

      // Level 1: Province/City selection
      aimagSelectNew.addEventListener('change', function() {
        selectedAimag = this.value;
        selectedDistrictSum = '';
        selectedHoroo = '';
        
        if (!selectedAimag) {
          districtSumContainer.classList.add('hidden');
          horooContainer.classList.add('hidden');
          selectedDisplay.classList.add('hidden');
          return;
        }

        const region = addressData[selectedAimag];
        
        // Clear and populate level 2
        districtSumSelectNew.innerHTML = '<option value="">-- Select --</option>';
        
        if (region.type === 'city') {
          // Ulaanbaatar - show districts
          districtSumLabel.textContent = 'District';
          Object.keys(region.districts).forEach(district => {
            const option = document.createElement('option');
            option.value = district;
            option.textContent = district;
            districtSumSelectNew.appendChild(option);
          });
        } else {
          // Aimag - show sums
          districtSumLabel.textContent = 'Sum';
          region.sums.forEach(sum => {
            const option = document.createElement('option');
            option.value = sum;
            option.textContent = sum;
            districtSumSelectNew.appendChild(option);
          });
        }
        
        districtSumContainer.classList.remove('hidden');
        horooContainer.classList.add('hidden');
        selectedDisplay.classList.add('hidden');
      });

      // Level 2: District/Sum selection
      districtSumSelectNew.addEventListener('change', function() {
        selectedDistrictSum = this.value;
        selectedHoroo = '';
        
        if (!selectedDistrictSum) {
          horooContainer.classList.add('hidden');
          selectedDisplay.classList.add('hidden');
          return;
        }

        const region = addressData[selectedAimag];
        
        if (region.type === 'city') {
          // Show horoo selection for Ulaanbaatar
          const district = region.districts[selectedDistrictSum];
          horooSelectNew.innerHTML = '<option value="">-- Select Horoo --</option>';
          
          district.horoos.forEach(horoo => {
            const option = document.createElement('option');
            option.value = horoo;
            option.textContent = horoo;
            horooSelectNew.appendChild(option);
          });
          
          horooContainer.classList.remove('hidden');
          selectedDisplay.classList.add('hidden');
        } else {
          // Aimag - no horoo, show final address
          horooContainer.classList.add('hidden');
          updateSelectedAddress();
        }
      });

      // Level 3: Horoo selection (only for Ulaanbaatar)
      horooSelectNew.addEventListener('change', function() {
        selectedHoroo = this.value;
        if (selectedHoroo) {
          updateSelectedAddress();
        } else {
          selectedDisplay.classList.add('hidden');
        }
      });
    }

    function updateSelectedAddress() {
      const selectedDisplay = document.getElementById('selectedAddressDisplay');
      const selectedText = document.getElementById('selectedAddressText');
      
      let addressParts = [selectedAimag, selectedDistrictSum];
      if (selectedHoroo) addressParts.push(selectedHoroo);
      
      selectedText.textContent = addressParts.join(' > ');
      selectedDisplay.classList.remove('hidden');
    }

    async function saveAddress() {
      if (!selectedAimag || !selectedDistrictSum) {
        showNotification('❌ Please select your address', 'error');
        return;
      }

      const region = addressData[selectedAimag];
      if (region.type === 'city' && !selectedHoroo) {
        showNotification('❌ Please select your horoo', 'error');
        return;
      }
      
      const additionalDetails = document.getElementById('addressDetails').value;
      
      try {
        const response = await fetch('/api/profile/update', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            userId: window.__USER_ID__,
            aimag: selectedAimag,
            sum: selectedDistrictSum,
            horoo: selectedHoroo || null,
            addressDetail: additionalDetails || null
          })
        });

        const data = await response.json();

        if (response.ok) {
          showNotification('✅ Address saved successfully!');
          cancelEditAddress();
          setTimeout(() => window.location.reload(), 1500);
        } else {
          showNotification('❌ Error: ' + (data.error || 'Failed to save address'), 'error');
        }
      } catch (error) {
        console.error('Save address error:', error);
        showNotification('❌ Network error. Please try again.', 'error');
      }
    }

    function logout() {
      if (confirm('Are you sure you want to logout?')) {
        showNotification('Logging out...');
        setTimeout(function() {
          window.location.href = '/shop';
        }, 1000);
      }
    }

    function showNotification(message, type = 'success') {
      const notification = document.createElement('div');
      const bgColor = type === 'error' ? 'bg-red-500' : 'bg-green-500';
      notification.className = `fixed top-4 right-4 ${bgColor} text-white px-6 py-3 rounded-lg shadow-lg z-50 animate-slide-in`;
      notification.textContent = message;
      
      document.body.appendChild(notification);
      
      setTimeout(function() {
        notification.style.opacity = '0';
        notification.style.transform = 'translateX(400px)';
        notification.style.transition = 'all 0.3s ease';
        setTimeout(function() {
          notification.remove();
        }, 300);
      }, 3000);
    }

    document.addEventListener('DOMContentLoaded', function() {
      loadWishlist();
      updateWishlistCount();
      
      document.querySelectorAll('.profile-nav-btn').forEach(function(btn) {
        if (btn.classList.contains('active')) {
          btn.classList.add('bg-orange-50', 'text-orange-600', 'font-medium');
        } else {
          btn.classList.add('text-gray-700', 'hover:bg-gray-50');
        }
      });
      
      document.querySelectorAll('.profile-nav-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          document.querySelectorAll('.profile-nav-btn').forEach(function(b) {
            b.classList.remove('bg-orange-50', 'text-orange-600', 'font-medium', 'active');
            b.classList.add('text-gray-700', 'hover:bg-gray-50');
          });
          
          btn.classList.add('bg-orange-50', 'text-orange-600', 'font-medium', 'active');
          btn.classList.remove('text-gray-700', 'hover:bg-gray-50');
        });
      });
    });

    async function loadWishlist() {
      try {
        if (!window.__USER_ID__ || window.__USER_ID__ === '') {
          console.error('No user ID found - user not authenticated');
          showNotification('❌ Please log in to view your wishlist', 'error');
          renderWishlist([]);
          updateWishlistCount(0);
          return;
        }
        
        const response = await fetch(`/api/wishlist?userId=${window.__USER_ID__}`);
        const data = await response.json();
        
        if (data.success) {
          renderWishlist(data.wishlist || []);
          updateWishlistCount(data.count || 0);
        } else {
          console.error('Wishlist error:', data.error);
          showNotification(`❌ ${data.error}`, 'error');
          renderWishlist([]);
          updateWishlistCount(0);
        }
      } catch (error) {
        console.error('Error loading wishlist:', error);
        showNotification('❌ Error loading wishlist. Please try again.', 'error');
        renderWishlist([]);
        updateWishlistCount(0);
      }
    }

    function renderWishlist(wishlist) {
      const emptyWishlist = document.getElementById('emptyWishlist');
      const wishlistGrid = document.getElementById('wishlistGrid');
      
      console.log('Rendering wishlist:', wishlist);
      
      if (!wishlist || wishlist.length === 0) {
        if (emptyWishlist) emptyWishlist.classList.remove('hidden');
        if (wishlistGrid) wishlistGrid.classList.add('hidden');
        return;
      }
      
      if (emptyWishlist) emptyWishlist.classList.add('hidden');
      if (wishlistGrid) {
        wishlistGrid.classList.remove('hidden');
        
        wishlistGrid.innerHTML = wishlist.map(item => {
          const addedDate = new Date(item.addedAt).toLocaleDateString('en-US', { 
            year: 'numeric', 
            month: 'short', 
            day: 'numeric' 
          });
          
          const rating = item.rating ? '⭐'.repeat(Math.floor(item.rating)) : '';
          
          return `
            <div class="bg-white border-2 border-gray-200 rounded-lg overflow-hidden hover:shadow-lg transition-all">
              <div class="flex flex-col sm:flex-row">
                <div class="w-full sm:w-40 h-40 bg-gray-100 flex-shrink-0 relative">
                  <img 
                    src="${item.image || 'https://via.placeholder.com/400x300?text=No+Image'}" 
                    alt="${item.name || 'Product'}"
                    class="w-full h-full object-cover"
                    onerror="this.src='https://via.placeholder.com/400x300?text=No+Image';"
                  />
                  ${item.stock_quantity === 0 ? '<div class="absolute inset-0 bg-red-500 bg-opacity-20 flex items-center justify-center"><span class="bg-red-500 text-white px-2 py-1 rounded text-xs font-bold">OUT OF STOCK</span></div>' : ''}
                </div>
                <div class="flex-1 p-4 flex flex-col">
                  <div class="flex items-start justify-between mb-2">
                    <div class="flex-1">
                      <h3 class="text-lg font-bold text-gray-900 mb-1">${item.name || 'Unnamed Product'}</h3>
                      <p class="text-sm text-gray-600 mb-2 line-clamp-2">${item.description || 'No description available'}</p>
                      ${rating ? `<p class="text-sm text-yellow-500 mb-1">${rating} (${item.rating})</p>` : ''}
                      <p class="text-xs text-gray-400">Added on ${addedDate}</p>
                    </div>
                    <button 
                      onclick="removeFromWishlist(${item.productId})"
                      class="text-red-500 hover:text-red-700 ml-3 flex-shrink-0 p-1 rounded-full hover:bg-red-50 transition-colors"
                      title="Remove from wishlist"
                    >
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                      </svg>
                    </button>
                  </div>
                  <div class="mt-auto flex items-center justify-between">
                    <div class="flex flex-col">
                      <span class="text-2xl font-bold text-orange-600">$${parseFloat(item.price || 0).toFixed(2)}</span>
                      <span class="text-xs text-gray-500">${item.stock_quantity || 0} in stock</span>
                    </div>
                    <button 
                      onclick="addToCartFromWishlist(${item.productId}, '${(item.name || '').replace(/'/g, "\\'")}', ${item.price || 0}, '${(item.image || '').replace(/'/g, "\\'")}', ${item.stock_quantity || 0})" 
                      class="bg-orange-500 text-white px-6 py-2 rounded-lg hover:bg-orange-600 transition-colors font-medium flex items-center gap-2 ${item.stock_quantity === 0 ? 'opacity-50 cursor-not-allowed bg-gray-400' : ''}"
                      ${item.stock_quantity === 0 ? 'disabled' : ''}
                    >
                      ${item.stock_quantity === 0 ? 
                        '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728L5.636 5.636m12.728 12.728L18 12M6 6l12 12"></path></svg> Out of Stock' : 
                        '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4m0 0L7 13m0 0l-2.5 5M7 13l2.5 5m4.5-5a2 2 0 100 4 2 2 0 000-4zm6 0a2 2 0 100 4 2 2 0 000-4z"></path></svg> Add to Cart'
                      }
                    </button>
                  </div>
                </div>
              </div>
            </div>
          `;
        }).join('');
      }
    }

    async function removeFromWishlist(productId) {
      try {
        console.log('Removing product', productId, 'from wishlist for user', window.__USER_ID__);
        
        const response = await fetch(`/api/wishlist?userId=${window.__USER_ID__}&productId=${productId}`, {
          method: 'DELETE'
        });
        
        const data = await response.json();
        
        if (data.success) {
          const productName = data.data?.productName || 'Product';
          showNotification(`💔 ${productName} removed from wishlist`);
          // Reload page to show updated wishlist from database
          setTimeout(() => {
            window.location.reload();
          }, 1000);
        } else {
          console.error('Remove error:', data.error);
          if (data.notFound) {
            showNotification('❌ Item not found in wishlist', 'error');
            setTimeout(() => {
              window.location.reload();
            }, 1000);
          } else {
            showNotification(`❌ ${data.error}`, 'error');
          }
        }
      } catch (error) {
        console.error('Error removing from wishlist:', error);
        showNotification('❌ Failed to remove from wishlist. Please try again.', 'error');
      }
    }

    function addToCartFromWishlist(productId, productName, productPrice, productImage, stockQuantity) {
      try {
        if (stockQuantity === 0) {
          showNotification('❌ Sorry, this item is out of stock', 'error');
          return;
        }
        
        const cart = JSON.parse(localStorage.getItem('cart') || '[]');
        const existingItemIndex = cart.findIndex(item => item.id === productId);
        
        if (existingItemIndex > -1) {
          const newQuantity = cart[existingItemIndex].quantity + 1;
          
          if (newQuantity > stockQuantity) {
            showNotification(`❌ Only ${stockQuantity} items available in stock`, 'error');
            return;
          }
          
          cart[existingItemIndex].quantity = newQuantity;
          showNotification(`✓ Updated ${productName} quantity in cart! (${newQuantity})`);
        } else {
          cart.push({
            id: productId,
            name: productName,
            price: productPrice,
            image: productImage,
            quantity: 1,
            maxStock: stockQuantity
          });
          showNotification(`✓ ${productName} added to cart!`);
        }
        
        localStorage.setItem('cart', JSON.stringify(cart));
        
        // Update cart count if there's a cart counter on the page
        const event = new CustomEvent('cartUpdated', { 
          detail: { 
            action: 'add', 
            productId, 
            productName,
            totalItems: cart.reduce((sum, item) => sum + item.quantity, 0)
          } 
        });
        window.dispatchEvent(event);
        
      } catch (error) {
        console.error('Error adding to cart:', error);
        showNotification('❌ Failed to add to cart', 'error');
      }
    }

    function updateWishlistCount(count) {
      const countElement = document.getElementById('wishlistCount');
      if (countElement) {
        if (count !== undefined) {
          countElement.textContent = count;
        } else {
          fetch(`/api/wishlist?userId=${window.__USER_ID__}`)
            .then(res => res.json())
            .then(data => {
              if (data.success) {
                countElement.textContent = data.count || 0;
              }
            })
            .catch(error => {
              console.error('Error updating wishlist count:', error);
            });
        }
      }
    }
  </script>
</Layout>