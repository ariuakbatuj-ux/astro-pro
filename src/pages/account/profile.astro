---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';
import { verifyToken } from '../../lib/auth';
import mongoliaAddresses from '../../data/mongoliaAddresses.js';

// Get JWT from cookies
const cookies = Astro.cookies;
const token = cookies.get('token')?.value || '';

let userId: number | null = null;
let user: any = null;
let profile: any = null;
let orders: any[] = [];
let wishlist: any[] = [];
let userError = null;

if (token) {
  const decoded = verifyToken(token);
  if (decoded && decoded.userId) {
    userId = typeof decoded.userId === 'string' ? parseInt(decoded.userId) : decoded.userId;
  } else {
    return Astro.redirect('/auth/signin');
  }
} else {
  return Astro.redirect('/auth/signin');
}

if (userId) {
  // Fetch user data from database
  const { data: userData, error: uErr } = await supabase
    .from('users')
    .select('_id, username, email, first_name, last_name, phone, role, account_status, created_at')
    .eq('_id', userId)
    .single();
  
  userError = uErr;

  // Fetch user profile data
  const { data: profileData } = await supabase
    .from('profiles')
    .select('_id, name, phone, aimag, sum, horoo, address_detail, language, currency, birthday')
    .eq('user_id', userId)
    .single();

  // Fetch user orders - limit to 10 most recent
  const { data: ordersData } = await supabase
    .from('orders')
    .select('_id, order_number, total_amount, status, payment_method, payment_status, created_at, shipping_address')
    .eq('user_id', userId)
    .order('created_at', { ascending: false })
    .limit(10);

  // Fetch wishlist items with product details - limit to 20 most recent
  const { data: wishlistData } = await supabase
    .from('wishlist')
    .select(`
      _id,
      product_id,
      created_at,
      products!inner (
        _id,
        name,
        description,
        price,
        images,
        stock_quantity,
        rating,
        status
      )
    `)
    .eq('user_id', userId)
    .eq('products.status', 'active')
    .order('created_at', { ascending: false })
    .limit(20);

  // Transform data for frontend
  user = userData ? {
    id: userData._id,
    username: userData.username,
    email: userData.email,
    firstName: userData.first_name || '',
    lastName: userData.last_name || '',
    phone: userData.phone || '',
    role: userData.role,
    accountStatus: userData.account_status,
  createdAt: userData.created_at
  } : null;

  profile = profileData ? {
    id: profileData._id,
    name: profileData.name || '',
    phone: profileData.phone || '',
    aimag: profileData.aimag || '',
    sum: profileData.sum || '',
    horoo: profileData.horoo || '',
    addressDetail: profileData.address_detail || '',
    language: profileData.language || 'en',
    currency: profileData.currency || 'USD',
    birthday: profileData.birthday || ''
  } : {
    name: '',
    phone: '',
    aimag: '',
    sum: '',
    horoo: '',
    addressDetail: '',
    language: 'en',
    currency: 'USD',
    birthday: ''
  };

  orders = ordersData?.map(order => ({
    id: order._id,
    orderNumber: order.order_number,
    totalAmount: order.total_amount,
    status: order.status,
    paymentMethod: order.payment_method,
    paymentStatus: order.payment_status,
    createdAt: new Date(order.created_at).toLocaleDateString('en-US', { 
      year: 'numeric', 
      month: 'long', 
      day: 'numeric' 
    }),
    shippingAddress: order.shipping_address
  })) || [];

  // Transform wishlist data
  wishlist = wishlistData?.map((item: any) => {
    // Handle both array and object response from Supabase
    const product = Array.isArray(item.products) ? item.products[0] : item.products;
    
    // Handle image parsing
    let imageUrl = 'https://via.placeholder.com/400x300?text=No+Image';
    if (product?.images) {
      try {
        if (Array.isArray(product.images) && product.images.length > 0) {
          imageUrl = product.images[0];
        } else if (typeof product.images === 'string') {
          const parsed = JSON.parse(product.images);
          imageUrl = Array.isArray(parsed) && parsed.length > 0 ? parsed[0] : imageUrl;
        }
      } catch (e) {
        if (typeof product.images === 'string' && product.images.startsWith('http')) {
          imageUrl = product.images;
        }
      }
    }
    
    return {
      wishlistId: item._id,
      productId: product?._id,
      name: product?.name || 'Unnamed Product',
      description: product?.description || 'No description available',
      price: parseFloat(product?.price) || 0,
      image: imageUrl,
      stock_quantity: product?.stock_quantity || 0,
      rating: product?.rating || 0,
      addedAt: new Date(item.created_at).toLocaleDateString('en-US', { 
        year: 'numeric', 
        month: 'long', 
        day: 'numeric' 
      })
    };
  }) || [];
} else {
  userError = 'Not authenticated';
}const getInitials = (name: string, username: string) => {
  if (name) {
    const parts = name.split(' ');
    return parts.length > 1 
      ? `${parts[0][0]}${parts[1][0]}`.toUpperCase()
      : name.substring(0, 2).toUpperCase();
  }
  return username.substring(0, 2).toUpperCase();
};

const userInitials = user ? getInitials(profile?.name || '', user.username) : 'U';
const displayName = profile?.name || `${user?.firstName || ''} ${user?.lastName || ''}`.trim() || user?.username || 'User';
const firstName = user?.firstName || (profile?.name ? profile.name.split(' ')[0] : '');
const lastName = user?.lastName || (profile?.name ? profile.name.split(' ').slice(1).join(' ') : '');

if (userError || !user) {
  console.error('Error fetching user:', userError);
}
---

<Layout title="Profile - ShopHub" description="Manage your profile and account settings">
  
  <div class="min-h-screen bg-gray-50">
    <!-- Header -->
    <header class="bg-white shadow-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center space-x-4">
            <a href="/shop" class="text-xl font-bold text-orange-600">ShopHub</a>
            <nav class="hidden md:flex space-x-6">
              <a href="/shop" class="text-gray-700 hover:text-orange-600 transition-colors">Shop</a>
              <a href="/account/orders" class="text-gray-700 hover:text-orange-600 transition-colors">My Orders</a>
              <a href="/account/profile" class="text-orange-600 font-medium">Profile</a>
            </nav>
          </div>
          <div class="flex items-center space-x-4">
            <button onclick="logout()" class="text-gray-700 hover:text-red-600 transition-colors">Logout</button>
          </div>
        </div>
      </div>
    </header>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        <!-- Sidebar Navigation -->
        <div class="lg:col-span-1">
          <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <div class="text-center mb-6">
              <div class="w-20 h-20 bg-orange-500 rounded-full mx-auto flex items-center justify-center mb-3">
                <span class="text-2xl font-bold text-white" id="userInitials">{userInitials}</span>
              </div>
              <h3 class="text-lg font-semibold text-gray-900" id="userName">{displayName}</h3>
              <p class="text-sm text-gray-600">@{user?.username || 'username'}</p>
              <p class="text-sm text-gray-600" id="userEmail">{user?.email || 'user@example.com'}</p>
            </div>
            
            <nav class="space-y-2">
              <button onclick="showSection('personal')" class="profile-nav-btn active w-full text-left px-4 py-2 rounded-lg transition-colors">
                Personal Info
              </button>
              <button onclick="showSection('address')" class="profile-nav-btn w-full text-left px-4 py-2 rounded-lg transition-colors">
                Addresses
              </button>
              <button onclick="showSection('wishlist')" class="profile-nav-btn w-full text-left px-4 py-2 rounded-lg transition-colors">
                <span class="flex items-center justify-between">
                  Wishlist
                  <span id="wishlistCount" class="bg-orange-500 text-white text-xs px-2 py-1 rounded-full">{wishlist.length}</span>
                </span>
              </button>
              <button onclick="showSection('orders')" class="profile-nav-btn w-full text-left px-4 py-2 rounded-lg transition-colors">
                Order History
              </button>
              <button onclick="showSection('security')" class="profile-nav-btn w-full text-left px-4 py-2 rounded-lg transition-colors">
                Security
              </button>
              <button onclick="showSection('preferences')" class="profile-nav-btn w-full text-left px-4 py-2 rounded-lg transition-colors">
                Preferences
              </button>
            </nav>
          </div>
        </div>

        <!-- Main Content -->
        <div class="lg:col-span-3">
          <!-- Personal Information Section -->
          <div id="personalSection" class="profile-section bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <div class="flex items-center justify-between mb-6">
              <h2 class="text-2xl font-bold text-gray-900">Personal Information</h2>
              <button onclick="toggleEdit('personal')" id="editPersonalBtn" class="text-orange-600 hover:text-orange-700 font-medium">
                Edit
              </button>
            </div>
            
            <form id="personalForm" class="space-y-6">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">First Name</label>
                  <input type="text" id="firstName" value={firstName} class="profile-input w-full px-3 py-2 border border-gray-300 rounded-md" disabled>
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Last Name</label>
                  <input type="text" id="lastName" value={lastName} class="profile-input w-full px-3 py-2 border border-gray-300 rounded-md" disabled>
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Phone</label>
                  <input type="tel" id="phone" value={user?.phone || profile?.phone || ''} class="profile-input w-full px-3 py-2 border border-gray-300 rounded-md" disabled>
                </div>
              </div>
              
              <div id="personalActions" class="hidden">
                <div class="flex space-x-4">
                  <button type="button" onclick="savePersonal()" class="bg-orange-500 text-white px-6 py-2 rounded-md hover:bg-orange-600 transition-colors">
                    Save Changes
                  </button>
                  <button type="button" onclick="cancelEdit('personal')" class="bg-gray-300 text-gray-700 px-6 py-2 rounded-md hover:bg-gray-400 transition-colors">
                    Cancel
                  </button>
                </div>
              </div>
            </form>
          </div>

          <!-- Address Section -->
          <div id="addressSection" class="profile-section hidden bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <div class="flex items-center justify-between mb-6">
              <h2 class="text-2xl font-bold text-gray-900">Address Information</h2>
              <button onclick="toggleEditAddress()" id="editAddressBtn" class="text-orange-600 hover:text-orange-700 font-medium">
                Edit
              </button>
            </div>
            
            <!-- Address Form -->
            <div id="addressForm" class="hidden mb-6">
              <div class="space-y-4">
                <div class="p-3 bg-blue-50 border border-blue-200 rounded-lg mb-4">
                  <p class="text-sm text-blue-800 font-medium mb-1">� Select Your Address</p>
                  <p class="text-sm text-blue-700">Choose your province/city, then district/sum, and horoo (if applicable)</p>
                </div>

                <!-- Level 1: Province/City -->
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Province / City *</label>
                  <select 
                    id="aimagSelect" 
                    class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500"
                  >
                    <option value="">-- Select Province/City --</option>
                    {Object.keys(mongoliaAddresses).map(aimag => (
                      <option value={aimag}>{aimag}</option>
                    ))}
                  </select>
                </div>

                <!-- Level 2: District/Sum -->
                <div id="districtSumContainer" class="hidden">
                  <label class="block text-sm font-medium text-gray-700 mb-2">
                    <span id="districtSumLabel">District / Sum</span> *
                  </label>
                  <select 
                    id="districtSumSelect" 
                    class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500"
                  >
                    <option value="">-- Select --</option>
                  </select>
                </div>

                <!-- Level 3: Horoo (only for Ulaanbaatar) -->
                <div id="horooContainer" class="hidden">
                  <label class="block text-sm font-medium text-gray-700 mb-2">Horoo *</label>
                  <select 
                    id="horooSelect" 
                    class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500"
                  >
                    <option value="">-- Select Horoo --</option>
                  </select>
                </div>

                <!-- Selected Address Display -->
                <div id="selectedAddressDisplay" class="hidden p-4 bg-green-50 border border-green-200 rounded-lg">
                  <p class="text-sm font-medium text-green-800 mb-1">✓ Selected Address:</p>
                  <p id="selectedAddressText" class="text-gray-800 font-medium"></p>
                </div>
                
                <!-- Additional Details -->
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Additional Details (Optional)</label>
                  <input 
                    type="text" 
                    id="addressDetails" 
                    placeholder="e.g., Building 5, Apartment 23, Near Central Park"
                    class="w-full px-3 py-2 border border-gray-300 rounded-md"
                    value={profile?.addressDetail || ''}
                  />
                  <p class="text-xs text-gray-500 mt-1">Add specific building, apartment, or landmark information</p>
                </div>

                <!-- Action Buttons -->
                <div class="flex space-x-4">
                  <button type="button" onclick="saveAddress()" class="bg-orange-500 text-white px-6 py-2 rounded-md hover:bg-orange-600 transition-colors flex-1">
                    💾 Save Address
                  </button>
                  <button type="button" onclick="cancelEditAddress()" class="bg-gray-300 text-gray-700 px-6 py-2 rounded-md hover:bg-gray-400 transition-colors">
                    Cancel
                  </button>
                </div>
              </div>
            </div>
            
            <div id="savedAddress">
              {(profile?.aimag || profile?.sum || profile?.horoo) ? (
                <div class="border border-gray-200 rounded-lg p-4">
                  <div class="flex items-center justify-between mb-2">
                    <span class="bg-orange-100 text-orange-800 px-2 py-1 rounded-full text-xs font-medium">📍 Primary Address</span>
                  </div>
                  <p class="text-gray-900 font-medium">{displayName}</p>
                  <div class="mt-3 space-y-1">
                    {profile.aimag && <p class="text-gray-700"><span class="font-medium">Province/City:</span> {profile.aimag}</p>}
                    {profile.sum && <p class="text-gray-700"><span class="font-medium">District/Sum:</span> {profile.sum}</p>}
                    {profile.horoo && <p class="text-gray-700"><span class="font-medium">Horoo:</span> {profile.horoo}</p>}
                    {profile.addressDetail && <p class="text-gray-700 mt-2"><span class="font-medium">Details:</span> {profile.addressDetail}</p>}
                  </div>
                  {(user?.phone || profile.phone) && <p class="text-gray-600 mt-3 pt-3 border-t">Phone: {user?.phone || profile.phone}</p>}
                </div>
              ) : (
                <div class="text-center py-8">
                  <svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                  <p class="text-gray-500">No address saved yet</p>
                  <p class="text-sm text-gray-400 mt-2">Click "Edit" to select your address</p>
                </div>
              )}
            </div>
          </div>

          <!-- Wishlist Section -->
          <div id="wishlistSection" class="profile-section hidden bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">My Wishlist</h2>
            
            {wishlist.length === 0 ? (
              <div class="text-center py-12">
                <svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                </svg>
                <p class="text-gray-500 text-lg">Your wishlist is empty</p>
                <a href="/shop" class="mt-4 inline-block bg-orange-500 text-white px-6 py-2 rounded-md hover:bg-orange-600 transition-colors">
                  Browse Products
                </a>
              </div>
            ) : (
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {wishlist.map((item) => (
                  <div class="border border-gray-200 rounded-lg overflow-hidden hover:shadow-md transition-shadow">
                    <div class="relative">
                      <img 
                        src={item.image} 
                        alt={item.name}
                        class="w-full h-48 object-cover"
                      />
                      {item.stock_quantity === 0 && (
                        <div class="absolute top-2 right-2 bg-red-500 text-white px-2 py-1 rounded-md text-xs font-medium">
                          Out of Stock
                        </div>
                      )}
                    </div>
                    
                    <div class="p-4">
                      <h3 class="font-semibold text-gray-900 mb-2 line-clamp-2">{item.name}</h3>
                      <p class="text-sm text-gray-600 mb-3 line-clamp-2">{item.description}</p>
                      
                      <div class="flex items-center justify-between mb-3">
                        <div>
                          <span class="text-2xl font-bold text-orange-500">${item.price.toFixed(2)}</span>
                          {item.rating > 0 && (
                            <div class="flex items-center mt-1">
                              <span class="text-yellow-400">★</span>
                              <span class="text-sm text-gray-600 ml-1">{item.rating.toFixed(1)}</span>
                            </div>
                          )}
                        </div>
                        {item.stock_quantity > 0 && (
                          <span class="text-sm text-green-600">In Stock ({item.stock_quantity})</span>
                        )}
                      </div>
                      
                      <p class="text-xs text-gray-400 mb-3">Added on {item.addedAt}</p>
                      
                      <div class="flex gap-2">
                        <a 
                          href={`/shop/product/${item.productId}`}
                          class="flex-1 bg-orange-500 text-white px-4 py-2 rounded-md hover:bg-orange-600 transition-colors text-center text-sm"
                        >
                          View Product
                        </a>
                        <button 
                          onclick={`removeFromWishlist(${item.productId})`}
                          class="bg-red-500 text-white px-4 py-2 rounded-md hover:bg-red-600 transition-colors text-sm"
                          title="Remove from wishlist"
                        >
                          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                          </svg>
                        </button>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>

          <!-- Order History Section -->
          <div id="ordersSection" class="profile-section hidden bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">Order History</h2>
            
            {orders.length === 0 ? (
              <div class="text-center py-12">
                <svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
                </svg>
                <p class="text-gray-500 text-lg">No orders yet</p>
                <a href="/shop" class="mt-4 inline-block bg-orange-500 text-white px-6 py-2 rounded-md hover:bg-orange-600 transition-colors">
                  Start Shopping
                </a>
              </div>
            ) : (
              <div class="space-y-4">
                {orders.map((order) => (
                  <div class="border border-gray-200 rounded-lg p-4 hover:border-gray-300 transition-colors">
                    <div class="flex items-center justify-between mb-4">
                      <div>
                        <h3 class="font-semibold text-gray-900">Order #{order.orderNumber}</h3>
                        <p class="text-sm text-gray-600">Placed on {order.createdAt}</p>
                      </div>
                      <div class="text-right">
                        <p class="font-semibold text-gray-900">${order.totalAmount.toFixed(2)}</p>
                        <span class={`px-2 py-1 rounded-full text-xs font-medium ${
                          order.status === 'delivered' ? 'bg-green-100 text-green-800' :
                          order.status === 'shipped' ? 'bg-blue-100 text-blue-800' :
                          order.status === 'pending' ? 'bg-yellow-100 text-yellow-800' :
                          'bg-gray-100 text-gray-800'
                        }`}>
                          {order.status.charAt(0).toUpperCase() + order.status.slice(1)}
                        </span>
                      </div>
                    </div>
                    <div class="mt-4 pt-4 border-t border-gray-200">
                      <div class="flex space-x-4">
                        <button class="text-orange-600 hover:text-orange-700 text-sm font-medium">View Details</button>
                        {order.status === 'delivered' && (
                          <button class="text-orange-600 hover:text-orange-700 text-sm font-medium">Reorder</button>
                        )}
                        {order.status === 'pending' && (
                          <button class="text-red-600 hover:text-red-700 text-sm font-medium">Cancel Order</button>
                        )}
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>

          <!-- Security Section -->
          <div id="securitySection" class="profile-section hidden bg-white rounded-lg shadow-sm border border-gray-200 p-6">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">Security Settings</h2>
            
            <div class="space-y-8">
              <!-- Account Information (Read-Only) -->
              <div>
                <h3 class="text-lg font-medium text-gray-900 mb-4">Account Information</h3>
                <div class="space-y-4 max-w-md bg-gray-50 p-4 rounded-lg">
                  <div>
                    <label class="block text-sm font-medium text-gray-600 mb-1">Username</label>
                    <p class="text-gray-900 font-medium">@{user?.username || 'username'}</p>
                    <p class="text-xs text-gray-500 mt-1">Username cannot be changed</p>
                  </div>
                  <div>
                    <label class="block text-sm font-medium text-gray-600 mb-1">Email Address</label>
                    <p class="text-gray-900 font-medium">{user?.email || 'user@example.com'}</p>
                    <p class="text-xs text-gray-500 mt-1">Contact support to change your email</p>
                  </div>
                  <div>
                    <label class="block text-sm font-medium text-gray-600 mb-1">Account Status</label>
                    <span class={`inline-block px-2 py-1 rounded-full text-xs font-medium ${
                      user?.accountStatus === 'active' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800'
                    }`}>
                      {user?.accountStatus === 'active' ? '✓ Active' : user?.accountStatus || 'Unknown'}
                    </span>
                  </div>
                </div>
              </div>
              
              <div class="border-t border-gray-200 pt-8">
                <h3 class="text-lg font-medium text-gray-900 mb-4">Change Password</h3>
                <form class="space-y-4 max-w-md">
                  <div>
