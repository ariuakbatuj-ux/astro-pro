  <script is:inline>
    window.__USER_ID__ = "${user ? user.id : ''}";
    window.__DEBUG_AUTH__ = {
      hasToken: "${token ? 'yes' : 'no'}",
      userId: "${userId || 'null'}",
      userFound: "${user ? 'yes' : 'no'}",
      userError: "${userError || 'none'}"
    };
    window.__SAVED_ADDRESS__ = {
      aimag: "${profile?.aimag || ''}",
      sum: "${profile?.sum || ''}",
      horoo: "${profile?.horoo || ''}"
    };
    
    console.log('Saved Address:', window.__SAVED_ADDRESS__);
    
    function showSection(sectionName) {
      // Hide all sections
      document.querySelectorAll('.profile-section').forEach(section => {
        section.classList.add('hidden');
      });
      
      // Remove active class from all nav buttons
      document.querySelectorAll('.profile-nav-btn').forEach(btn => {
        btn.classList.remove('active');
      });
      
      // Show selected section
      const targetSection = document.getElementById(sectionName + 'Section');
      if (targetSection) {
        targetSection.classList.remove('hidden');
      }
    }

    function toggleEdit(section) {
      const inputs = document.querySelectorAll('#' + section + 'Form .profile-input');
      const actions = document.getElementById(section + 'Actions');
      const btn = document.getElementById('edit' + section.charAt(0).toUpperCase() + section.slice(1) + 'Btn');
      
      if (inputs.length === 0) {
        return;
      }
      
      const firstInput = inputs[0];
      const isEditing = firstInput && firstInput.disabled === false;
      
      inputs.forEach(input => {
        if (input && typeof input.disabled !== 'undefined') {
          input.disabled = isEditing;
        }
        if (isEditing) {
          input.classList.remove('bg-white', 'focus:ring-2', 'focus:ring-orange-500');
          input.classList.add('bg-gray-100');
        } else {
          input.classList.add('bg-white', 'focus:ring-2', 'focus:ring-orange-500');
          input.classList.remove('bg-gray-100');
        }
      });
      
      if (isEditing) {
        if (actions) actions.classList.add('hidden');
        if (btn) btn.textContent = 'Edit';
      } else {
        if (actions) actions.classList.remove('hidden');
        if (btn) btn.textContent = 'Cancel';
      }
    }

    async function savePersonal() {
      const firstName = document.getElementById('firstName').value;
      const lastName = document.getElementById('lastName').value;
      const phone = document.getElementById('phone').value;
      const aimag = document.getElementById('aimagSelect').value;
      const sum = document.getElementById('sumSelect').value;
      const horoo = document.getElementById('horooSelect').value;
      const addressDetail = document.getElementById('addressDetail').value;
      
        const birthdayInput = document.getElementById('birthday');
        const birthday = birthdayInput ? birthdayInput.value : null;

      try {
        const requestBody = {
          userId: window.__USER_ID__,
          firstName,
          lastName,
          phone,
          aimag,
          sum,
          horoo,
          addressDetail
        };

        if (birthday) {
          requestBody.birthday = birthday;
        }        const response = await fetch('/api/profile/update', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(requestBody)
        });

        const data = await response.json();

        if (response.ok) {
          showNotification('✅ Profile updated successfully!');
          
          const fullName = `${firstName} ${lastName}`.trim();
          const userNameElement = document.getElementById('userName');
          if (userNameElement && fullName) {
            userNameElement.textContent = fullName;
          }
          
          const userInitialsElement = document.getElementById('userInitials');
          if (userInitialsElement && fullName) {
            const parts = fullName.split(' ');
            const initials = parts.length > 1 
              ? `${parts[0][0]}${parts[1][0]}`.toUpperCase()
              : fullName.substring(0, 2).toUpperCase();
            userInitialsElement.textContent = initials;
          }
          
          cancelEdit('personal');
        } else {
          showNotification('❌ Error: ' + (data.error || 'Failed to update profile'), 'error');
        }
      } catch (error) {
        console.error('Save error:', error);
        showNotification('❌ Network error. Please try again.', 'error');
      }
    }

    function cancelEdit(section) {
      const inputs = document.querySelectorAll('#' + section + 'Form .profile-input');
      const actions = document.getElementById(section + 'Actions');
      const btn = document.getElementById('edit' + section.charAt(0).toUpperCase() + section.slice(1) + 'Btn');
      
      inputs.forEach(input => {
        if (input && typeof input.disabled !== 'undefined') {
          input.disabled = true;
        }
        input.classList.remove('bg-white', 'focus:ring-2', 'focus:ring-orange-500');
        input.classList.add('bg-gray-100');
      });
      
      if (actions) actions.classList.add('hidden');
      if (btn) btn.textContent = 'Edit';
    }

    async function savePreferences() {
      const language = document.getElementById('languageSelect').value;
      const currency = document.getElementById('currencySelect').value;

      try {
        const response = await fetch('/api/profile/preferences', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            userId: window.__USER_ID__,
            language,
            currency
          })
        });

        const data = await response.json();

        if (response.ok) {
          showNotification('✅ Preferences saved successfully!');
        } else {
          showNotification('❌ Error: ' + (data.error || 'Failed to save preferences'), 'error');
        }
      } catch (error) {
        console.error('Save preferences error:', error);
        showNotification('❌ Network error. Please try again.', 'error');
      }
    }

    let currentAimagType = null;
    async function loadAimags() {
      try {
        const response = await fetch('/api/addresses/aimags');
        
        if (!response.ok) {
          console.error('API response not OK:', response.status, response.statusText);
          return;
        }
        
        const result = await response.json();
        
        if (!result.success) {
          console.error('Failed to load aimags');
          return;
        }

        const aimagSelect = document.getElementById('aimagSelect');
        const currentAimag = aimagSelect.getAttribute('data-value');
        
        aimagSelect.innerHTML = '<option value="">Сонгоно уу...</option>';
        
        result.data.forEach((aimag, index) => {
          const option = document.createElement('option');
          option.value = aimag.name;
          option.textContent = aimag.name;
          option.setAttribute('data-type', aimag.type);
          if (currentAimag && aimag.name === currentAimag) {
            option.selected = true;
            currentAimagType = aimag.type;
          }
          aimagSelect.appendChild(option);
        });

        if (currentAimag) {
          await loadDistrictsOrSums(currentAimag, currentAimagType);
        }
      } catch (error) {
        console.error('Error loading aimags:', error);
      }
    }

    async function loadDistrictsOrSums(aimag, aimagType) {
      try {
        const response = await fetch(`/api/addresses/districts-sums/${encodeURIComponent(aimag)}`);
        
        if (!response.ok) {
          console.error('Districts/sums API error:', response.status, response.statusText);
          return;
        }
        
        const result = await response.json();
        
        if (!result.success) {
          console.error('Failed to load districts/sums');
          return;
        }

        const sumSelect = document.getElementById('sumSelect');
        const horooDiv = document.getElementById('horooDiv');
        const sumLabel = document.getElementById('sumLabel');
        const currentSum = sumSelect.getAttribute('data-value');
        
        sumSelect.innerHTML = '<option value="">Сонгоно уу...</option>';
        document.getElementById('horooSelect').innerHTML = '<option value="">Сонгоно уу...</option>';
        
        result.data.forEach((item) => {
          const option = document.createElement('option');
          option.value = item;
          option.textContent = item;
          if (currentSum && item === currentSum) {
            option.selected = true;
          }
          sumSelect.appendChild(option);
        });
        
        if (aimagType === 'city') {
          sumLabel.textContent = 'Дүүрэг (District)';
          horooDiv.style.display = 'block';
        } else {
          sumLabel.textContent = 'Сум (Sum)';
          horooDiv.style.display = 'none';
        }

        if (currentSum && aimagType === 'city') {
          await loadHoroos(aimag, currentSum);
        }
      } catch (error) {
        console.error('Error loading districts/sums:', error);
      }
    }

    async function loadHoroos(aimag, district) {
      try {
        const response = await fetch(
          `/api/addresses/horoos/${encodeURIComponent(aimag)}/${encodeURIComponent(district)}`
        );
        const result = await response.json();
        
        if (!result.success) {
          console.log('No horoos available');
          return;
        }
        
        const horooSelect = document.getElementById('horooSelect');
        const currentHoroo = horooSelect.getAttribute('data-value');
        
        horooSelect.innerHTML = '<option value="">Сонгоно уу...</option>';
        
        result.data.forEach(horoo => {
          const option = document.createElement('option');
          option.value = horoo;
          option.textContent = horoo;
          if (currentHoroo && horoo === currentHoroo) {
            option.selected = true;
          }
          horooSelect.appendChild(option);
        });
      } catch (error) {
        console.error('Error loading horoos:', error);
      }
    }

    function setupAddressListeners() {
      const aimagSelect = document.getElementById('aimagSelect');
      const sumSelect = document.getElementById('sumSelect');

      const savedAimag = profileData?.aimag || '';
      const savedSum = profileData?.sum || '';
      const savedHoroo = profileData?.horoo || '';
      
      aimagSelect.setAttribute('data-value', savedAimag);
      sumSelect.setAttribute('data-value', savedSum);
      document.getElementById('horooSelect').setAttribute('data-value', savedHoroo);

      aimagSelect.addEventListener('change', (e) => {
        const aimag = e.target.value;
        const aimagType = e.target.options[e.target.selectedIndex].getAttribute('data-type');
        currentAimagType = aimagType;
        
        if (aimag) {
          loadDistrictsOrSums(aimag, aimagType);
        } else {
          // Reset
          sumSelect.innerHTML = '<option value="">Сонгоно уу...</option>';
          document.getElementById('horooSelect').innerHTML = '<option value="">Сонгоно уу...</option>';
          document.getElementById('horooDiv').style.display = 'none';
        }
      });
      
      sumSelect.addEventListener('change', (e) => {
        const aimag = aimagSelect.value;
        const district = e.target.value;
        
        if (currentAimagType === 'city' && district) {
          loadHoroos(aimag, district);
        }
      });
    }

