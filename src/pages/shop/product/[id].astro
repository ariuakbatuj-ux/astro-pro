---
import Layout from '../../../layouts/Layout.astro';
import { supabase } from '../../../lib/supabase';
import { verifyToken } from '../../../lib/auth';

const { id } = Astro.params;

// Get user ID from JWT token if logged in
const cookies = Astro.cookies;
const token = cookies.get('token')?.value || '';
let userId: number | null = null;

if (token) {
  const decoded = verifyToken(token);
  if (decoded && decoded.userId) {
    userId = typeof decoded.userId === 'string' ? parseInt(decoded.userId) : decoded.userId;
  }
}

// Fetch product details
const { data: product, error } = await supabase
  .from('products')
  .select(`
    *,
    categories (
      name,
      slug
    )
  `)
  .eq('_id', id)
  .single();

if (!product) {
  return Astro.redirect('/shop');
}

// Parse JSONB fields
const images = product.images || [];
const variants = product.variants || {};
const colors = variants.colors || [];
const sizes = variants.sizes || [];

// Fetch reviews for this product
const { data: reviewsData } = await supabase
  .from('reviews')
  .select(`
    _id,
    product_id,
    user_id,
    rating,
    comment,
    helpful_count,
    created_at,
    users!inner (
      _id,
      username,
      profiles (
        name
      )
    )
  `)
  .eq('product_id', id)
  .eq('status', 'approved')
  .order('created_at', { ascending: false });

// Format reviews
const reviews = reviewsData?.map((review: any) => {
  const user = review.users;
  const displayName = user?.username || 'Anonymous';
  
  return {
    id: review._id,
    userId: review.user_id,
    rating: review.rating,
    comment: review.comment,
    helpfulCount: review.helpful_count,
    createdAt: new Date(review.created_at).toLocaleDateString('en-US', { 
      year: 'numeric', 
      month: 'long', 
      day: 'numeric' 
    }),
    userName: displayName,
    userInitials: displayName.substring(0, 2).toUpperCase()
  };
}) || [];

// Check if current user has already reviewed this product
let userHasReviewed = false;
let userReview = null;
if (userId) {
  userReview = reviews.find((r: any) => r.userId === userId);
  userHasReviewed = !!userReview;
}

// Calculate rating distribution
const ratingDistribution = [5, 4, 3, 2, 1].map(star => {
  const count = reviews.filter((r: any) => r.rating === star).length;
  const percentage = reviews.length > 0 ? (count / reviews.length) * 100 : 0;
  return { star, count, percentage };
});

// Calculate actual rating and count from reviews (override database values)
const actualRating = reviews.length > 0 
  ? reviews.reduce((sum: number, r: any) => sum + r.rating, 0) / reviews.length 
  : 0;
const actualReviewCount = reviews.length;

const mainImage = images[0] || '/images/placeholder-product.png';
---

<Layout title={`${product.name} - ShopHub`} description={product.description || 'Product details'}>
  <div class="min-h-screen bg-gray-50">
    <!-- Header -->
    <header class="bg-white shadow-sm sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center space-x-4">
            <a href="/shop" class="text-xl font-bold text-orange-600">ShopHub</a>
            <nav class="hidden md:flex space-x-6">
              <a href="/shop" class="text-gray-700 hover:text-orange-600 transition-colors">← Back to Shop</a>
            </nav>
          </div>
          <div class="flex items-center space-x-4">
            <button id="cartToggle" class="relative text-gray-700 hover:text-orange-600 transition-colors">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
              </svg>
              <span id="cartCount" class="absolute -top-2 -right-2 bg-orange-500 text-white text-xs rounded-full h-5 w-5 flex items-center justify-center">0</span>
            </button>
            <a href="/account/profile" class="text-gray-700 hover:text-orange-600">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- Cart Sidebar -->
    <div id="cartSidebar" class="fixed inset-y-0 right-0 z-50 w-96 bg-white shadow-xl transform translate-x-full transition-transform duration-300 ease-in-out">
      <div class="flex flex-col h-full">
        <div class="flex items-center justify-between p-6 border-b border-gray-200">
          <h2 class="text-lg font-semibold text-gray-900">Shopping Cart</h2>
          <button id="closeCart" class="text-gray-400 hover:text-gray-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>
        
        <div id="cartItems" class="flex-1 overflow-y-auto p-6">
          <div id="emptyCart" class="text-center py-8">
            <svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4m0 0L7 13m0 0l-1.1 5.5A1 1 0 006.8 20H19"/>
            </svg>
            <p class="text-gray-500">Your cart is empty</p>
          </div>
        </div>
        
        <div id="cartFooter" class="border-t border-gray-200 p-6 hidden">
          <div class="flex justify-between items-center mb-4">
            <span class="text-lg font-semibold">Total:</span>
            <span id="cartTotal" class="text-xl font-bold text-orange-600">$0.00</span>
          </div>
          <a href="/shop/orders" class="block w-full bg-orange-500 text-white py-3 rounded-lg font-semibold hover:bg-orange-600 transition-colors text-center">
            Proceed to Checkout
          </a>
        </div>
      </div>
    </div>

    <!-- Product Detail -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 p-8">
          <!-- Product Images -->
          <div>
            <!-- Main Image -->
            <div class="aspect-square bg-gray-100 rounded-lg overflow-hidden mb-4">
              <img 
                id="mainImage"
                src={mainImage} 
                alt={product.name}
                class="w-full h-full object-cover"
              />
            </div>
            
            <!-- Thumbnail Gallery -->
            {images.length > 1 && (
              <div class="grid grid-cols-4 gap-4" id="thumbnails">
                {images.map((img: string, index: number) => (
                  <button 
                    type="button"
                    data-image-src={img}
                    class="thumbnail-btn aspect-square bg-gray-100 rounded-lg overflow-hidden border-2 border-transparent hover:border-orange-500 transition-colors"
                  >
                    <img 
                      src={img} 
                      alt={`${product.name} - Image ${index + 1}`}
                      class="w-full h-full object-cover"
                    />
                  </button>
                ))}
              </div>
            )}
          </div>

          <!-- Product Info -->
          <div class="flex flex-col">
            <!-- Category Badge -->
            {product.categories && (
              <a 
                href={`/shop?category=${product.categories.slug}`}
                class="inline-block w-fit px-3 py-1 bg-orange-100 text-orange-800 text-sm font-medium rounded-full mb-4 hover:bg-orange-200 transition-colors"
              >
                {product.categories.name}
              </a>
            )}

            <!-- Product Name -->
            <h1 class="text-3xl font-bold text-gray-900 mb-4">{product.name}</h1>

            <!-- Rating & Reviews -->
            <div class="flex items-center mb-6">
              <div class="flex items-center">
                {Array.from({ length: 5 }, (_, i) => (
                  <svg 
                    class={`w-5 h-5 ${i < Math.floor(actualRating) ? 'text-yellow-400' : 'text-gray-300'}`}
                    fill="currentColor" 
                    viewBox="0 0 20 20"
                  >
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                ))}
              </div>
              <span class="ml-2 text-gray-600">{actualRating.toFixed(1)} ({actualReviewCount} {actualReviewCount === 1 ? 'review' : 'reviews'})</span>
            </div>

            <!-- Price -->
            <div class="mb-6">
              <div class="flex items-baseline gap-4">
                <span class="text-4xl font-bold text-orange-600">${product.price}</span>
                {product.stock_quantity <= 10 && product.stock_quantity > 0 && (
                  <span class="text-sm text-red-600 font-medium">Only {product.stock_quantity} left!</span>
                )}
              </div>
            </div>

            <!-- Stock Status -->
            <div class="mb-6">
              {product.stock_quantity > 0 ? (
                <span class="inline-flex items-center px-3 py-1 bg-green-100 text-green-800 text-sm font-medium rounded-full">
                  <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  In Stock
                </span>
              ) : (
                <span class="inline-flex items-center px-3 py-1 bg-red-100 text-red-800 text-sm font-medium rounded-full">
                  <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                  </svg>
                  Out of Stock
                </span>
              )}
            </div>

            <!-- Color Options -->
            {colors.length > 0 && (
              <div class="mb-6">
                <label class="block text-sm font-medium text-gray-700 mb-3">Color</label>
                <div class="flex flex-wrap gap-3">
                  {colors.map((color: any) => (
                    <button 
                      type="button"
                      data-option-type="color"
                      data-option-value={color.name}
                      class="option-btn px-4 py-2 border-2 border-gray-300 rounded-lg hover:border-orange-500 focus:border-orange-500 focus:ring-2 focus:ring-orange-200 transition-colors"
                    >
                      {color.name}
                    </button>
                  ))}
                </div>
              </div>
            )}

            <!-- Size Options -->
            {sizes.length > 0 && (
              <div class="mb-6">
                <label class="block text-sm font-medium text-gray-700 mb-3">Size</label>
                <div class="flex flex-wrap gap-3">
                  {sizes.map((size: string) => (
                    <button 
                      type="button"
                      data-option-type="size"
                      data-option-value={size}
                      class="option-btn px-4 py-2 border-2 border-gray-300 rounded-lg hover:border-orange-500 focus:border-orange-500 focus:ring-2 focus:ring-orange-200 transition-colors"
                    >
                      {size}
                    </button>
                  ))}
                </div>
              </div>
            )}

            <!-- Quantity Selector -->
            <div class="mb-6">
              <label class="block text-sm font-medium text-gray-700 mb-3">Quantity</label>
              <div class="flex items-center gap-3">
                <button 
                  type="button"
                  id="decrementBtn"
                  class="w-10 h-10 flex items-center justify-center border-2 border-gray-300 rounded-lg hover:border-orange-500 transition-colors"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"/>
                  </svg>
                </button>
                <input 
                  type="number" 
                  id="quantity" 
                  value="1" 
                  min="1" 
                  max={product.stock_quantity}
                  class="w-20 text-center border-2 border-gray-300 rounded-lg py-2 focus:outline-none focus:border-orange-500"
                />
                <button 
                  type="button"
                  id="incrementBtn"
                  class="w-10 h-10 flex items-center justify-center border-2 border-gray-300 rounded-lg hover:border-orange-500 transition-colors"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                  </svg>
                </button>
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex gap-4 mb-8">
              <button 
                type="button"
                id="addToCartBtn"
                class="flex-1 bg-orange-600 text-white px-8 py-4 rounded-lg font-semibold hover:bg-orange-700 transition-colors flex items-center justify-center gap-2"
                disabled={product.stock_quantity === 0}
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
                </svg>
                Add to Cart
              </button>
              <button 
                type="button"
                id="toggleWishlistBtn"
                class="px-6 py-4 border-2 border-gray-300 rounded-lg hover:border-orange-500 transition-colors"
              >
                <svg class="w-6 h-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                </svg>
              </button>
            </div>

            <!-- Product Description -->
            {product.description && (
              <div class="border-t border-gray-200 pt-6">
                <h3 class="text-lg font-semibold text-gray-900 mb-3">Product Description</h3>
                <p class="text-gray-600 leading-relaxed">{product.description}</p>
              </div>
            )}

            <!-- Product Details -->
            <div class="border-t border-gray-200 pt-6 mt-6">
              <h3 class="text-lg font-semibold text-gray-900 mb-3">Product Details</h3>
              <dl class="space-y-2">
                <div class="flex">
                  <dt class="text-gray-600 w-32">SKU:</dt>
                  <dd class="text-gray-900 font-medium">{product.sku || 'N/A'}</dd>
                </div>
                <div class="flex">
                  <dt class="text-gray-600 w-32">Category:</dt>
                  <dd class="text-gray-900">{product.categories?.name || 'Uncategorized'}</dd>
                </div>
                <div class="flex">
                  <dt class="text-gray-600 w-32">Availability:</dt>
                  <dd class={product.stock_quantity > 0 ? 'text-green-600 font-medium' : 'text-red-600 font-medium'}>
                    {product.stock_quantity > 0 ? `${product.stock_quantity} in stock` : 'Out of stock'}
                  </dd>
                </div>
              </dl>
            </div>
          </div>
        </div>
      </div>

      <!-- Reviews Section -->
      <div class="mt-8 bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
        <div class="p-8">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">Customer Reviews</h2>
          
          <!-- Rating Summary -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8 pb-8 border-b border-gray-200">
            <!-- Overall Rating -->
            <div class="text-center">
              <div class="text-5xl font-bold text-orange-600 mb-2">{actualRating.toFixed(1)}</div>
              <div class="flex items-center justify-center mb-2">
                {Array.from({ length: 5 }, (_, i) => (
                  <svg 
                    class={`w-6 h-6 ${i < Math.floor(actualRating) ? 'text-yellow-400' : 'text-gray-300'}`}
                    fill="currentColor" 
                    viewBox="0 0 20 20"
                  >
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                ))}
              </div>
              <div class="text-gray-600">{actualReviewCount} {actualReviewCount === 1 ? 'review' : 'reviews'}</div>
            </div>

            <!-- Rating Distribution -->
            <div class="md:col-span-2">
              {ratingDistribution.map(({ star, count, percentage }) => (
                <div class="flex items-center gap-3 mb-2">
                  <span class="text-sm text-gray-600 w-12">{star} star</span>
                  <div class="flex-1 h-3 bg-gray-200 rounded-full overflow-hidden">
                    <div 
                      class="h-full bg-yellow-400 rounded-full"
                      style={`width: ${percentage}%`}
                    ></div>
                  </div>
                  <span class="text-sm text-gray-600 w-12 text-right">{count}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Filter Reviews -->
          <div class="mb-6">
            <label class="block text-sm font-medium text-gray-700 mb-2">Filter by rating:</label>
            <div class="flex flex-wrap gap-2">
              <button 
                type="button"
                data-rating="all"
                class="filter-rating-btn px-4 py-2 border-2 border-orange-500 bg-orange-50 text-orange-700 rounded-lg font-medium hover:bg-orange-100 transition-colors"
              >
                All
              </button>
              {[5, 4, 3, 2, 1].map(star => (
                <button 
                  type="button"
                  data-rating={star}
                  class="filter-rating-btn px-4 py-2 border-2 border-gray-300 text-gray-700 rounded-lg font-medium hover:border-orange-500 hover:bg-orange-50 transition-colors"
                >
                  {star} ★
                </button>
              ))}
            </div>
          </div>

          <!-- Write Review Form -->
          {userId ? (
            <div id="reviewFormContainer" class="mb-8">
              {userHasReviewed ? (
                <div class="bg-green-50 border border-green-200 rounded-lg p-4 mb-4">
                  <p class="text-green-800 font-medium">✓ You've already reviewed this product</p>
                  <button 
                    type="button"
                    id="editReviewBtn"
                    class="mt-2 text-orange-600 hover:text-orange-700 font-medium"
                  >
                    Edit your review
                  </button>
                </div>
              ) : (
                <button 
                  type="button"
                  id="showReviewFormBtn"
                  class="w-full md:w-auto bg-orange-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-orange-700 transition-colors"
                >
                  Write a Review
                </button>
              )}
              
              <div id="reviewForm" class="hidden mt-4 bg-gray-50 border border-gray-200 rounded-lg p-6">
                <h3 class="text-lg font-semibold text-gray-900 mb-4">Write Your Review</h3>
                
                <div class="mb-4">
                  <label class="block text-sm font-medium text-gray-700 mb-2">Rating *</label>
                  <div class="flex gap-2" id="ratingStars">
                    {[1, 2, 3, 4, 5].map(star => (
                      <button 
                        type="button"
                        data-rating={star}
                        class="rating-star-btn w-10 h-10 text-gray-300 hover:text-yellow-400 transition-colors"
                      >
                        <svg class="w-full h-full" fill="currentColor" viewBox="0 0 20 20">
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                        </svg>
                      </button>
                    ))}
                  </div>
                  <input type="hidden" id="selectedRating" value={userReview?.rating || ''} />
                </div>

                <div class="mb-4">
                  <label for="reviewComment" class="block text-sm font-medium text-gray-700 mb-2">Your Review</label>
                  <textarea 
                    id="reviewComment"
                    rows="4"
                    placeholder="Share your thoughts about this product..."
                    class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500"
                  >{userReview?.comment || ''}</textarea>
                </div>

                <div class="flex gap-3">
                  <button 
                    type="button"
                    id="submitReviewBtn"
                    class="bg-orange-600 text-white px-6 py-2 rounded-lg font-semibold hover:bg-orange-700 transition-colors"
                  >
                    Submit Review
                  </button>
                  <button 
                    type="button"
                    id="cancelReviewBtn"
                    class="bg-gray-300 text-gray-700 px-6 py-2 rounded-lg font-semibold hover:bg-gray-400 transition-colors"
                  >
                    Cancel
                  </button>
                  {userHasReviewed && (
                    <button 
                      type="button"
                      id="deleteReviewBtn"
                      class="ml-auto bg-red-500 text-white px-6 py-2 rounded-lg font-semibold hover:bg-red-600 transition-colors"
                    >
                      Delete Review
                    </button>
                  )}
                </div>
              </div>
            </div>
          ) : (
            <div class="mb-8 bg-yellow-50 border border-yellow-200 rounded-lg p-4">
              <p class="text-yellow-800">
                <a href="/auth/signin" class="font-medium underline hover:text-yellow-900">Sign in</a> to write a review
              </p>
            </div>
          )}

          <!-- Reviews List -->
          <div id="reviewsList">
            {reviews.length === 0 ? (
              <div class="text-center py-12">
                <svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"/>
                </svg>
                <p class="text-gray-500 text-lg">No reviews yet</p>
                <p class="text-gray-400 mt-2">Be the first to review this product!</p>
              </div>
            ) : (
              <div class="space-y-6">
                {reviews.map((review: any) => (
                  <div class="review-item border-b border-gray-200 pb-6 last:border-0" data-rating={review.rating}>
                    <div class="flex items-start gap-4">
                      <div class="flex-shrink-0 w-12 h-12 bg-orange-100 text-orange-600 rounded-full flex items-center justify-center font-bold">
                        {review.userInitials}
                      </div>
                      <div class="flex-1">
                        <div class="flex items-center justify-between mb-2">
                          <div>
                            <h4 class="font-semibold text-gray-900">{review.userName}</h4>
                            <div class="flex items-center gap-2 mt-1">
                              <div class="flex">
                                {Array.from({ length: 5 }, (_, i) => (
                                  <svg 
                                    class={`w-4 h-4 ${i < review.rating ? 'text-yellow-400' : 'text-gray-300'}`}
                                    fill="currentColor" 
                                    viewBox="0 0 20 20"
                                  >
                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                                  </svg>
                                ))}
                              </div>
                              <span class="text-sm text-gray-500">{review.createdAt}</span>
                            </div>
                          </div>
                        </div>
                        {review.comment && (
                          <p class="text-gray-700 leading-relaxed">{review.comment}</p>
                        )}
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ productId: product._id, maxStock: product.stock_quantity, productData: product, currentUserId: userId, userHasReviewed, userReviewData: userReview }}>
    let selectedColor = null;
    let selectedSize = null;
    let isInWishlist = false;

    // Check if product is in wishlist on page load
    document.addEventListener('DOMContentLoaded', function() {
      checkWishlistStatus();
      updateCartCount();

      // Thumbnail delegation
      const thumbs = document.getElementById('thumbnails');
      if (thumbs) {
        thumbs.addEventListener('click', function(e) {
          const btn = e.target.closest('.thumbnail-btn');
          if (!btn) return;
          const src = btn.getAttribute('data-image-src');
          if (src) changeImage(src);
        });
      }

      // Option buttons delegation
      document.querySelectorAll('.option-btn').forEach(btn => {
        btn.addEventListener('click', function(e) {
          const type = this.getAttribute('data-option-type');
          const value = this.getAttribute('data-option-value');
          selectOption(type, value);
          // highlight selected
          document.querySelectorAll(`.option-btn[data-option-type="${type}"]`).forEach(b => b.classList.remove('border-orange-500','bg-orange-50'));
          this.classList.add('border-orange-500','bg-orange-50');
        });
      });

      // Wire all button event listeners
      const addToCartBtn = document.getElementById('addToCartBtn');
      const toggleWishlistBtn = document.getElementById('toggleWishlistBtn');
      const decrementBtn = document.getElementById('decrementBtn');
      const incrementBtn = document.getElementById('incrementBtn');

      if (addToCartBtn) addToCartBtn.addEventListener('click', addToCart);
      if (toggleWishlistBtn) toggleWishlistBtn.addEventListener('click', toggleWishlist);
      if (decrementBtn) decrementBtn.addEventListener('click', decrementQuantity);
      if (incrementBtn) incrementBtn.addEventListener('click', incrementQuantity);

      // Cart toggle functionality
      const cartToggle = document.getElementById('cartToggle');
      const closeCart = document.getElementById('closeCart');
      const cartSidebar = document.getElementById('cartSidebar');

      if (cartToggle) {
        cartToggle.addEventListener('click', function() {
          cartSidebar.classList.remove('translate-x-full');
        });
      }

      if (closeCart) {
        closeCart.addEventListener('click', function() {
          cartSidebar.classList.add('translate-x-full');
        });
      }

      // Setup cart event delegation for cart item buttons
      setupCartEventListeners();

      // Initial cart UI update
      updateCartUI();
      updateCartCount();
      
      // Check and update wishlist button state
      checkWishlistStatus();

      // Setup review functionality
      setupReviewFunctionality();
    });

    function checkWishlistStatus() {
      if (!currentUserId) {
        console.log('No user logged in, skipping wishlist check');
        return;
      }
      
      fetch(`/api/wishlist?userId=${currentUserId}`)
        .then(res => res.json())
        .then(data => {
          const wishlist = data.wishlist || [];
          // Check for productId field that comes from the API
          isInWishlist = wishlist.some(item => 
            item.productId === productId || item.product_id === productId || item.id === productId
          );
          updateWishlistButton();
        })
        .catch(error => {
          console.error('Error checking wishlist status:', error);
        });
    }

    function updateWishlistButton() {
      const wishlistBtn = document.getElementById('toggleWishlistBtn');
      if (wishlistBtn) {
        const svg = wishlistBtn.querySelector('svg');
        if (isInWishlist) {
          svg.setAttribute('fill', 'currentColor');
          svg.classList.add('text-red-500');
          svg.classList.remove('text-gray-600');
          wishlistBtn.classList.add('border-red-500');
          wishlistBtn.classList.remove('border-gray-300');
        } else {
          svg.setAttribute('fill', 'none');
          svg.classList.remove('text-red-500');
          svg.classList.add('text-gray-600');
          wishlistBtn.classList.remove('border-red-500');
          wishlistBtn.classList.add('border-gray-300');
        }
      }
    }

    function changeImage(src) {
      document.getElementById('mainImage').src = src;
    }

    function selectOption(type, value) {
      if (type === 'color') {
        selectedColor = value;
      } else if (type === 'size') {
        selectedSize = value;
      }
      // Note: Visual highlighting is now handled by event delegation in DOMContentLoaded
    }

    function incrementQuantity() {
      const input = document.getElementById('quantity');
      const current = parseInt(input.value);
      if (current < maxStock) {
        input.value = current + 1;
      }
    }

    function decrementQuantity() {
      const input = document.getElementById('quantity');
      const current = parseInt(input.value);
      if (current > 1) {
        input.value = current - 1;
      }
    }

    function addToCart() {
      const quantity = parseInt(document.getElementById('quantity').value) || 1;

      // Load cart from localStorage
      let cart = JSON.parse(localStorage.getItem('cart') || '[]');

      // Find existing item (match id + selected options)
      const existingItemIndex = cart.findIndex(item => 
        item.id === productId &&
        (item.color || null) === (selectedColor || null) &&
        (item.size || null) === (selectedSize || null)
      );

      if (existingItemIndex > -1) {
        cart[existingItemIndex].quantity = (cart[existingItemIndex].quantity || 0) + quantity;
        showNotification(`✓ Updated cart — ${cart[existingItemIndex].quantity} in cart`);
      } else {
        const item = {
          id: productId,
          name: productData.name,
          price: Number(productData.price) || 0,
          image: productData.images?.[0] || '/images/placeholder-product.png',
          quantity: quantity,
          color: selectedColor,
          size: selectedSize,
          addedAt: new Date().toISOString()
        };

        cart.push(item);
        showNotification(`✓ Added ${quantity} item(s) to cart!`);
      }

      // Save and notify other pages
      localStorage.setItem('cart', JSON.stringify(cart));
      updateCartCount();
      updateCartUI(); // Update the cart sidebar UI

      // If shop page provides a global UI updater, call it safely
      try {
        if (typeof window !== 'undefined' && typeof window.updateCartUI === 'function') {
          window.updateCartUI();
        }
      } catch (e) {
        // ignore
      }
    }

    function toggleWishlist() {
      if (!currentUserId) {
        showNotification('⚠️ Please sign in to use wishlist', 'error');
        setTimeout(() => {
          window.location.href = '/auth/signin';
        }, 1500);
        return;
      }
      
      // Optimistically update UI immediately
      isInWishlist = !isInWishlist;
      updateWishlistButton();
      
      if (!isInWishlist) {
        // Remove from database
        fetch(`/api/wishlist?userId=${currentUserId}&productId=${productId}`, {
          method: 'DELETE'
        })
          .then(res => res.json())
          .then(data => {
            showNotification('💔 Removed from wishlist');
            window.dispatchEvent(new Event('storage'));
          })
          .catch(error => {
            // Revert on error
            isInWishlist = true;
            updateWishlistButton();
            console.error('Error removing from wishlist:', error);
            showNotification('❌ Error removing from wishlist', 'error');
          });
      } else {
        // Add to database
        fetch('/api/wishlist', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            userId: currentUserId,
            productId: productId
          })
        })
          .then(res => res.json())
          .then(data => {
            showNotification('❤️ Added to wishlist!');
            window.dispatchEvent(new Event('storage'));
          })
          .catch(error => {
            // Revert on error
            isInWishlist = false;
            updateWishlistButton();
            console.error('Error adding to wishlist:', error);
            showNotification('❌ Error adding to wishlist', 'error');
          });
      }
    }

    function updateCartCount() {
      const cart = JSON.parse(localStorage.getItem('cart') || '[]');
      const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
      const cartCountElement = document.getElementById('cartCount');
      if (cartCountElement) {
        cartCountElement.textContent = totalItems;
      }
    }

    // Cart UI update function
    function updateCartUI() {
      const cart = JSON.parse(localStorage.getItem('cart') || '[]');
      const cartItemsContainer = document.getElementById('cartItems');
      const emptyCart = document.getElementById('emptyCart');
      const cartFooter = document.getElementById('cartFooter');
      const cartTotal = document.getElementById('cartTotal');

      if (cart.length === 0) {
        if (emptyCart) emptyCart.classList.remove('hidden');
        if (cartFooter) cartFooter.classList.add('hidden');
        cartItemsContainer.innerHTML = `
          <div id="emptyCart" class="text-center py-8">
            <svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4m0 0L7 13m0 0l-1.1 5.5A1 1 0 006.8 20H19"/>
            </svg>
            <p class="text-gray-500">Your cart is empty</p>
          </div>
        `;
        return;
      }

      if (emptyCart) emptyCart.classList.add('hidden');
      if (cartFooter) cartFooter.classList.remove('hidden');

      // Render cart items
      cartItemsContainer.innerHTML = cart.map(item => `
        <div class="flex gap-4 mb-4 pb-4 border-b border-gray-200">
          <img src="${item.image}" alt="${item.name}" class="w-20 h-20 object-cover rounded-lg">
          <div class="flex-1">
            <h3 class="font-medium text-gray-900">${item.name}</h3>
            ${item.color ? `<p class="text-sm text-gray-500">Color: ${item.color}</p>` : ''}
            ${item.size ? `<p class="text-sm text-gray-500">Size: ${item.size}</p>` : ''}
            <p class="text-orange-600 font-semibold">$${item.price}</p>
            <div class="flex items-center gap-2 mt-2">
              <button type="button" data-product-id="${item.id}" class="cart-decrease-btn w-6 h-6 flex items-center justify-center border border-gray-300 rounded hover:bg-gray-50">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"/>
                </svg>
              </button>
              <span class="text-gray-700 font-medium">${item.quantity}</span>
              <button type="button" data-product-id="${item.id}" class="cart-increase-btn w-6 h-6 flex items-center justify-center border border-gray-300 rounded hover:bg-gray-50">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
              </button>
              <button type="button" data-product-id="${item.id}" class="cart-remove-btn ml-2 text-red-500 hover:text-red-700 text-sm">Remove</button>
            </div>
          </div>
        </div>
      `).join('');

      // Calculate total
      const total = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
      if (cartTotal) {
        cartTotal.textContent = `$${total.toFixed(2)}`;
      }
    }

    // Event delegation for cart buttons
    function setupCartEventListeners() {
      const cartItemsContainer = document.getElementById('cartItems');
      if (!cartItemsContainer) return;

      cartItemsContainer.addEventListener('click', function(e) {
        const decreaseBtn = e.target.closest('.cart-decrease-btn');
        const increaseBtn = e.target.closest('.cart-increase-btn');
        const removeBtn = e.target.closest('.cart-remove-btn');

        if (decreaseBtn) {
          const productId = parseInt(decreaseBtn.getAttribute('data-product-id'));
          handleCartDecrease(productId);
        } else if (increaseBtn) {
          const productId = parseInt(increaseBtn.getAttribute('data-product-id'));
          handleCartIncrease(productId);
        } else if (removeBtn) {
          const productId = parseInt(removeBtn.getAttribute('data-product-id'));
          handleCartRemove(productId);
        }
      });
    }

    function handleCartDecrease(productId) {
      let cart = JSON.parse(localStorage.getItem('cart') || '[]');
      const itemIndex = cart.findIndex(item => item.id === productId);
      
      if (itemIndex !== -1) {
        if (cart[itemIndex].quantity > 1) {
          cart[itemIndex].quantity--;
        } else {
          cart.splice(itemIndex, 1);
        }
        localStorage.setItem('cart', JSON.stringify(cart));
        updateCartUI();
        updateCartCount();
      }
    }

    function handleCartIncrease(productId) {
      let cart = JSON.parse(localStorage.getItem('cart') || '[]');
      const item = cart.find(item => item.id === productId);
      
      if (item) {
        item.quantity++;
        localStorage.setItem('cart', JSON.stringify(cart));
        updateCartUI();
        updateCartCount();
      }
    }

    function handleCartRemove(productId) {
      let cart = JSON.parse(localStorage.getItem('cart') || '[]');
      cart = cart.filter(item => item.id !== productId);
      localStorage.setItem('cart', JSON.stringify(cart));
      updateCartUI();
      updateCartCount();
    }

    function showNotification(message) {
      const notification = document.createElement('div');
      notification.className = 'fixed top-4 right-4 bg-green-500 text-white px-6 py-3 rounded-lg shadow-lg z-50 animate-slide-in';
      notification.textContent = message;
      
      document.body.appendChild(notification);
      
      setTimeout(() => {
        notification.style.opacity = '0';
        notification.style.transform = 'translateX(400px)';
        notification.style.transition = 'all 0.3s ease';
        setTimeout(() => notification.remove(), 300);
      }, 3000);
    }

    // ========== REVIEW FUNCTIONALITY ==========
    let selectedRatingValue = userReviewData?.rating || 0;

    function setupReviewFunctionality() {
      // Show/hide review form
      const showReviewFormBtn = document.getElementById('showReviewFormBtn');
      const editReviewBtn = document.getElementById('editReviewBtn');
      const cancelReviewBtn = document.getElementById('cancelReviewBtn');
      const reviewForm = document.getElementById('reviewForm');

      if (showReviewFormBtn) {
        showReviewFormBtn.addEventListener('click', () => {
          reviewForm.classList.remove('hidden');
          showReviewFormBtn.classList.add('hidden');
        });
      }

      if (editReviewBtn) {
        editReviewBtn.addEventListener('click', () => {
          reviewForm.classList.remove('hidden');
        });
      }

      if (cancelReviewBtn) {
        cancelReviewBtn.addEventListener('click', () => {
          reviewForm.classList.add('hidden');
          if (showReviewFormBtn) showReviewFormBtn.classList.remove('hidden');
          if (!userHasReviewed) {
            selectedRatingValue = 0;
            updateRatingStars();
            document.getElementById('reviewComment').value = '';
          }
        });
      }

      // Rating stars
      const ratingStarBtns = document.querySelectorAll('.rating-star-btn');
      ratingStarBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          selectedRatingValue = parseInt(this.getAttribute('data-rating'));
          document.getElementById('selectedRating').value = selectedRatingValue;
          updateRatingStars();
        });
      });

      // Initialize rating stars if editing
      if (userHasReviewed && userReviewData) {
        selectedRatingValue = userReviewData.rating;
        updateRatingStars();
      }

      // Submit review
      const submitReviewBtn = document.getElementById('submitReviewBtn');
      if (submitReviewBtn) {
        submitReviewBtn.addEventListener('click', submitReview);
      }

      // Delete review
      const deleteReviewBtn = document.getElementById('deleteReviewBtn');
      if (deleteReviewBtn) {
        deleteReviewBtn.addEventListener('click', deleteReview);
      }

      // Filter reviews by rating
      const filterBtns = document.querySelectorAll('.filter-rating-btn');
      filterBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          // Update active state
          filterBtns.forEach(b => {
            b.classList.remove('border-orange-500', 'bg-orange-50', 'text-orange-700');
            b.classList.add('border-gray-300', 'text-gray-700');
          });
          this.classList.remove('border-gray-300', 'text-gray-700');
          this.classList.add('border-orange-500', 'bg-orange-50', 'text-orange-700');

          // Filter reviews
          const rating = this.getAttribute('data-rating');
          filterReviews(rating);
        });
      });
    }

    function updateRatingStars() {
      const stars = document.querySelectorAll('.rating-star-btn');
      stars.forEach((btn, index) => {
        if (index < selectedRatingValue) {
          btn.classList.remove('text-gray-300');
          btn.classList.add('text-yellow-400');
        } else {
          btn.classList.add('text-gray-300');
          btn.classList.remove('text-yellow-400');
        }
      });
    }

    async function submitReview() {
      if (!currentUserId) {
        showNotification('⚠️ Please sign in to submit a review');
        return;
      }

      if (selectedRatingValue === 0) {
        showNotification('⚠️ Please select a rating');
        return;
      }

      const comment = document.getElementById('reviewComment').value.trim();

      const submitBtn = document.getElementById('submitReviewBtn');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting...';

      try {
        const method = userHasReviewed ? 'PUT' : 'POST';
        const response = await fetch('/api/reviews', {
          method: method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            userId: currentUserId,
            productId: productId,
            rating: selectedRatingValue,
            comment: comment
          })
        });

        const data = await response.json();

        if (data.success) {
          showNotification(userHasReviewed ? '✓ Review updated successfully!' : '✓ Review submitted successfully!');
          setTimeout(() => {
            window.location.reload();
          }, 1500);
        } else {
          showNotification(`❌ ${data.error}`);
          submitBtn.disabled = false;
          submitBtn.textContent = 'Submit Review';
        }
      } catch (error) {
        console.error('Error submitting review:', error);
        showNotification('❌ Failed to submit review. Please try again.');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Submit Review';
      }
    }

    async function deleteReview() {
      if (!currentUserId) return;

      if (!confirm('Are you sure you want to delete your review?')) {
        return;
      }

      try {
        const response = await fetch(`/api/reviews?userId=${currentUserId}&productId=${productId}`, {
          method: 'DELETE'
        });

        const data = await response.json();

        if (data.success) {
          showNotification('✓ Review deleted successfully');
          setTimeout(() => {
            window.location.reload();
          }, 1500);
        } else {
          showNotification(`❌ ${data.error}`);
        }
      } catch (error) {
        console.error('Error deleting review:', error);
        showNotification('❌ Failed to delete review. Please try again.');
      }
    }

    function filterReviews(rating) {
      const reviewItems = document.querySelectorAll('.review-item');
      
      reviewItems.forEach(item => {
        if (rating === 'all') {
          item.style.display = 'block';
        } else {
          const itemRating = item.getAttribute('data-rating');
          if (itemRating === rating) {
            item.style.display = 'block';
          } else {
            item.style.display = 'none';
          }
        }
      });
    }
  </script>
</Layout>
