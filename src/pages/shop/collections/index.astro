---
import Layout from '../../../layouts/Layout.astro';
import { supabase } from '../../../lib/supabase';

const { data: categories } = await supabase
  .from('categories')
  .select('*')
  .eq('status', 'active')
  .order('name');
---

<Layout title="Shop by Collection" description="Browse our curated collections of products organized by category">
  <div class="min-h-screen bg-gray-50 py-12">
    <div class="container mx-auto px-4">
      <!-- Header -->
      <div class="mb-12 text-center">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">Shop by Collection</h1>
        <p class="text-lg text-gray-600">Browse our curated collections of products</p>
      </div>

      <!-- Collections Grid -->
      {categories && categories.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {categories.map(category => (
            <a 
              href={`/shop/collections/${category.slug || category.name.toLowerCase()}`}
              class="group relative h-80 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow"
            >
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent z-10" />
              <div class="absolute inset-0 bg-gray-300" />
              <div class="absolute bottom-0 left-0 right-0 p-6 z-20">
                <h2 class="text-3xl font-bold text-white mb-2 group-hover:text-orange-400 transition-colors">
                  {category.name}
                </h2>
                {category.description && (
                  <p class="text-gray-200 text-sm line-clamp-2">
                    {category.description}
                  </p>
                )}
                <div class="mt-4 flex items-center text-white group-hover:text-orange-400 transition-colors">
                  <span class="text-sm font-semibold">Shop Collection</span>
                  <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="text-center py-12">
          <p class="text-gray-600">No collections available at this time.</p>
        </div>
      )}
    </div>
  </div>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
