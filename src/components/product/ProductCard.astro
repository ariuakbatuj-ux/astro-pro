---
interface Props {
  id: number;
  name: string;
  price: number;
  image: string;
  rating?: number;
  inStock: boolean;
}

const { id, name, price, image, rating = 0, inStock } = Astro.props;
---

<div class="product-card bg-white rounded-lg shadow-sm hover:shadow-md transition-shadow overflow-hidden">
  <a href={`/shop/product/${id}`} class="block">
    <div class="relative">
      <img 
        src={image} 
        alt={name}
        class="w-full h-64 object-cover"
      />
      {!inStock && (
        <span class="absolute top-2 left-2 bg-red-500 text-white px-2 py-1 text-xs rounded font-semibold">
          Out of Stock
        </span>
      )}
    </div>
    <div class="p-4">
      <h3 class="font-semibold text-lg mb-2 line-clamp-2 hover:text-orange-600 transition-colors">
        {name}
      </h3>
      {rating > 0 && (
        <div class="flex items-center mb-2">
          <span class="text-yellow-400 text-sm">{'★'.repeat(Math.floor(rating))}</span>
          <span class="text-gray-300 text-sm">{'★'.repeat(5 - Math.floor(rating))}</span>
          <span class="ml-2 text-sm text-gray-600">({rating})</span>
        </div>
      )}
      <div class="flex items-center justify-between">
        <p class="text-2xl font-bold text-orange-600">${price.toFixed(2)}</p>
        {inStock && (
          <button 
            class="text-sm text-orange-600 hover:text-orange-700 font-semibold"
            onclick="addToCart(event)"
            data-product-id={id}
          >
            Add to Cart
          </button>
        )}
      </div>
    </div>
  </a>
</div>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  function addToCart(event: Event) {
    event.preventDefault();
    const button = event.target as HTMLElement;
    const productId = button.dataset.productId;
    
    // Dispatch custom event that cart sidebar can listen to
    window.dispatchEvent(new CustomEvent('addToCart', {
      detail: { productId }
    }));
  }
</script>
